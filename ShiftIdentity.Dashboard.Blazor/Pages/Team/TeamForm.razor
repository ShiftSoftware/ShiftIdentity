@using ShiftSoftware.ShiftBlazor.Enums
@using ShiftSoftware.ShiftEntity.Model.Dtos
@using ShiftSoftware.ShiftIdentity.Core.DTOs.Team
@using ShiftSoftware.ShiftIdentity.Core.DTOs.Company
@using ShiftSoftware.ShiftIdentity.Core.DTOs.CompanyBranch
@attribute [Authorize]
@layout Shared.DefaultLayout



@attribute [Route($"{Constants.IdentityRoutePreifix}/{nameof(TeamForm)}/{{Key?}}")]
@inject HttpClient Http
@inject ODataQuery odataQuery
@inject ShiftIdentityLocalizer Loc
@inject ShiftIdentityDashboardBlazorOptions Options

<ShiftEntityForm AllowSaveAsNew
                 Endpoint="@($"{Constants.IdentityRoutePreifix}Team")"
                 Title="@Loc["Team"]"
                 @bind-Key="@Key"
                 TypeAuthAction="ShiftIdentityActions.Teams"
                 T="ShiftSoftware.ShiftIdentity.Core.DTOs.Team.TeamDTO">
    <MudGrid Spacing="4">
        <MudItem lg="4" md="12" sm="12" xs="12">
            <MudTextField ReadOnly="@context.ReadOnly"
                          Disabled="@context.Disabled"
                          OnlyValidateIfDirty="true"
                          Label="@Loc["Team Name"]"
                          @bind-Value="context.Item.Name"
                          For="@(() => context.Item.Name)" />
        </MudItem>
        <MudItem lg="4" md="12" sm="12" xs="12">
            <MudTextField ReadOnly="@context.ReadOnly"
                          Disabled="@context.Disabled"
                          OnlyValidateIfDirty="true"
                          Label="@Loc["Integration ID"]"
                          @bind-Value="context.Item.IntegrationId"
                          For="@(() => context.Item.IntegrationId)" />
        </MudItem>
        <MudItem lg="4" md="12" sm="12" xs="12">
            <ShiftAutocomplete Label="@Loc["Company"]"
                               For="@(() => context.Item.Company)"
                               Value="context.Item.Company"
                               ValueChanged="(v) => { context.Item.Company = v; context.Item.CompanyBranches = new(); context.Item.Users = new(); }"
                               EntitySet="IdentityCompany"
                               TEntitySet="CompanyListDTO" />
        </MudItem>
        <MudItem lg="12" md="12" sm="12" xs="12">
            <ShiftAutocomplete Label="@Loc["Company Branch"]"
                               TEntitySet="CompanyBranchListDTO"
                               Filter="@(x=> x.Add(nameof(CompanyBranchListDTO.CompanyId), ShiftBlazor.Enums.ODataOperator.Equal, context.Item.Company.Value))"
                               Disabled="context.Item.Company == null"
                               @bind-SelectedValues="context.Item.CompanyBranches"
                               EntitySet="IdentityCompanyBranch"
                               MultiSelect />
        </MudItem>

        <MudItem lg="12" md="12" sm="12" xs="12">
            <ShiftAutocomplete Label="@Loc["Users"]"
                               TEntitySet="UserListDTO"
                               Filter="@(x=> x.Add(nameof(UserListDTO.CompanyID), ShiftBlazor.Enums.ODataOperator.Equal, context.Item.Company.Value))"
                               Disabled="context.Item.Company == null"
                               @bind-SelectedValues="context.Item.Users"
                               EntitySet="IdentityUser"
                               MultiSelect />
        </MudItem>

        <MudItem lg="12" md="12" sm="12" xs="12">
            <MudSelectExtended MultiSelection="true"
                               OnlyValidateIfDirty="true"
                               @bind-SelectedValues="context.Item.Tags"
                               T="string"
                               Label="@Loc["Tags"]">
                @foreach (var state in Options.TeamTags)
                {
                    <MudSelectItem T="string" Value="@state">@state</MudSelectItem>
                }
            </MudSelectExtended>
        </MudItem>
    </MudGrid>
</ShiftEntityForm>

@code {
    [Parameter]
    public object? Key { get; set; }
}
