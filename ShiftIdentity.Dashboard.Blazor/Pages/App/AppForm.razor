@attribute [Authorize]
@layout Shared.DefaultLayout
@attribute [Route($"{Constants.IdentityRoutePreifix}/{nameof(AppForm)}/{{Key?}}")]
@inject HttpClient Http
@inject ShiftIdentityLocalizer Loc
@using ShiftSoftware.ShiftIdentity.Core.DTOs.App


<ShiftEntityForm Endpoint="@($"{Constants.IdentityRoutePreifix}App")"
                 Title="@Loc["App"]"
                 @bind-Key="@Key"
                 AllowSaveAsNew
                 TypeAuthAction="ShiftIdentityActions.Apps"
                 Validator="validator"
                 OnResult="Loaded"
                 T="ShiftSoftware.ShiftIdentity.Core.DTOs.App.AppDTO">

    <MudTextField ReadOnly="@context.ReadOnly"
                  Disabled="@context.Disabled"
                  OnlyValidateIfDirty="true"
                  Label="@Loc["Display Name"]"
                  @bind-Value="context.Item.DisplayName"
                  For="@(() => context.Item.DisplayName)" />

    <MudTextField ReadOnly="@context.ReadOnly"
                  Disabled="@context.Disabled"
                  OnlyValidateIfDirty="true"
                  Label="@Loc["App Id"]"
                  @bind-Value="context.Item.AppId"
                  For="@(() => context.Item.AppId)" />

    <MudTextField ReadOnly="@context.ReadOnly"
                  Disabled="@context.Disabled"
                  OnlyValidateIfDirty="true"
                  Label="@Loc["Description"]"
                  @bind-Value="context.Item.Description"
                  For="@(() => context.Item.Description)" />

    <MudTextField ReadOnly="@context.ReadOnly"
                  Disabled="@context.Disabled"
                  OnlyValidateIfDirty="true"
                  Label="@Loc["Redirect URI"]"
                  @bind-Value="context.Item.RedirectUri"
                  For="@(() => context.Item.RedirectUri)" />

                  <br/>
    @if (!string.IsNullOrWhiteSpace(context.Item.RedirectUri))
    {
        <MudAlert Severity="Severity.Warning">@Loc["The user will be redirected to"] @AppTokenCallback.For(context.Item.RedirectUri)</MudAlert>
    }

    @*    <MudTextField ReadOnly="@context.ReadOnly"
    Disabled="@context.Disabled"
    OnlyValidateIfDirty="true"
    Label="Post Logout Redirect Uri"
    @bind-Value="context.Item.PostLogoutRedirectUri"
    For="@(() => context.Item.PostLogoutRedirectUri)" />*@
</ShiftEntityForm>

@code {
    [Parameter]
    public object? Key { get; set; }

    private AppValidator validator = default!;
    // The RedirectUri the server last returned for this row. The validator refuses a trailing "/" only in a new or
    // changed value, so an existing row that has one still saves unchanged (FE-2026-09-25-02).
    private string? registeredRedirectUri;

    protected override void OnInitialized() => validator = new AppValidator(Loc, () => registeredRedirectUri);

    private ValueTask<bool> Loaded(ShiftEntityResponse<AppDTO>? result)
    {
        if (result?.Entity is { } app)
            registeredRedirectUri = app.RedirectUri;
        return ValueTask.FromResult(true);
    }
}