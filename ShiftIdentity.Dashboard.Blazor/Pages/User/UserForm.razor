@attribute [Authorize]
@layout Shared.DefaultLayout

@attribute [Route($"{Constants.IdentityRoutePreifix}/{nameof(UserForm)}/{{Key?}}")]
@inject HttpClient Http
@inject ODataQuery odataQuery
@inject IDialogService DialogService
@inject ShiftIdentityLocalizer Loc
@inject ShiftIdentityDashboardBlazorOptions DashboardOptions
@inject ITypeAuthService TypeAuthService
@inject IServiceProvider Services

@using Microsoft.Extensions.DependencyInjection
@using ShiftSoftware.ShiftEntity.Model.Dtos
@using ShiftSoftware.ShiftBlazor.Enums
@using ShiftSoftware.ShiftIdentity.Core.DTOs.AccessTree
@using ShiftSoftware.ShiftIdentity.Core.DTOs.User
@using ShiftSoftware.ShiftIdentity.Core.DTOs.CompanyBranch
@using ShiftSoftware.ShiftIdentity.Core
@using MudBlazor

@if (AdmissionContext is not null)
{
    <ShiftSoftware.ShiftIdentity.Dashboard.Blazor.Pages.UserManager.AdmissionAccountPanel Context="AdmissionContext" UserKey="@(Key?.ToString())" Administrator="true" />
}
else
{
<ShiftEntityForm @bind-Value="_theItem"
                 Endpoint="@($"{Constants.IdentityRoutePreifix}User")"
                 Title="@Loc["User"]"
                 AllowSaveAsNew
                 @bind-Key="@Key"
                 Mode="_mode"
                 ModeChanged="ModeChanged"
                 TypeAuthAction="ShiftIdentityActions.Users"
                 OnTaskFinished="@(()=> ready=true)"
                 OnResult="HandleSaveResult"
                 OnSubmit="()=> { _theItem.AccessTree =  actionTree!.GenerateAccessTree(); }"
                 T="ShiftSoftware.ShiftIdentity.Core.DTOs.User.UserDTO">

    @* Related fields sit together: who the user is, how they sign in, how to reach them, what they may do. *@
    <MudStack Spacing="4">
        @if (verificationSendUnconfirmed)
        {
            <MudAlert Severity="Severity.Warning" data-testid="user-verification-unconfirmed">@Loc["The user was saved, but the verification send could not be confirmed. Check the recipient's inbox, wait and request a fresh link."]</MudAlert>
        }

        <FormSectionCard Title="@Loc["Profile"]" Icon="@Icons.Material.Filled.Person" data-testid="user-section-profile">
            <MudGrid Spacing="4">
                <MudItem xs="12" md="6">
                    <MudTextField ReadOnly="@context.ReadOnly"
                                  Disabled="@context.Disabled"
                                  OnlyValidateIfDirty="true"
                                  Label="@Loc["Full Name"]"
                                  @bind-Value="context.Item.FullName"
                                  For="@(() => context.Item.FullName)" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <ShiftAutocomplete Label="@Loc["Company Branch"]"
                                       For="@(() => context.Item.CompanyBranchID)"
                                       @bind-Value="context.Item.CompanyBranchID"
                                       TEntitySet="CompanyBranchListDTO"
                                       EntitySet="IdentityCompanyBranch" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudDatePicker ReadOnly="@context.ReadOnly"
                                   Disabled="@context.Disabled"
                                   Clearable
                                   @bind-Date="context.Item.BirthDate"
                                   For="@(() => context.Item.BirthDate)"
                                   Label="@Loc["Birth Date"]" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField ReadOnly="@context.ReadOnly"
                                  Disabled="@context.Disabled"
                                  OnlyValidateIfDirty="true"
                                  Label="@Loc["Integration ID"]"
                                  @bind-Value="context.Item.IntegrationId"
                                  For="@(() => context.Item.IntegrationId)" />
                </MudItem>
            </MudGrid>
        </FormSectionCard>

        <FormSectionCard Title="@Loc["Security"]" Icon="@Icons.Material.Filled.Lock" data-testid="user-section-security">
            <div class="user-security-groups">
                <section class="user-security-group" aria-label="@Loc["Sign-in details"]" data-testid="user-security-sign-in">
                    <div class="user-security-group-heading">
                        <MudText Typo="Typo.subtitle2">@Loc["Sign-in details"]</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Loc["Username, password and account access"]</MudText>
                    </div>

                    <div class="user-security-account">
                        <MudTextField ReadOnly="@context.ReadOnly"
                                      Disabled="@context.Disabled"
                                      OnlyValidateIfDirty="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Label="@Loc["Username"]"
                                      @bind-Value="context.Item.Username"
                                      For="@(() => context.Item.Username)" />
                        <MudCheckBox ReadOnly="@context.ReadOnly"
                                     Disabled="@context.Disabled"
                                     For="@(() => context.Item.IsActive)"
                                     Label="@Loc["Active"]"
                                     @bind-Value="@context.Item.IsActive" />
                    </div>

                    @* Keep the password, generator and next-sign-in choice together when the controls wrap. *@
                    <div class="user-security-password">
                        <div class="user-security-password-field" data-testid="user-password">
                            <PasswordField ReadOnly="@context.ReadOnly"
                                           Disabled="@context.Disabled"
                                           OnlyValidateIfDirty="true"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Label="@Loc["Password"]"
                                           @bind-Value="context.Item.Password"
                                           For="@(() => context.Item.Password)"
                                           HelperText="@Loc["Choose a strong password"]"
                                           autocomplete="new-password" />
                        </div>
                        <div class="user-security-password-generate">
                            <MudButton ButtonType="ButtonType.Button"
                                       Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Autorenew"
                                       Disabled="@(context.ReadOnly || context.Disabled)"
                                       OnClick="() => context.Item.Password = PasswordGenerator.GeneratePassword(GeneratedPasswordLength)">@Loc["Generate password"]</MudButton>
                        </div>
                    </div>

                    @if (PasswordChoiceApplies(context.Item, context.Mode))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Icon="@Icons.Material.Filled.Password" Class="mt-3" data-testid="user-password-require-change">
                            <MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="4">
                                <MudText Typo="Typo.body2">@Loc["A new password will be saved for this user."]</MudText>
                                <MudCheckBox T="bool"
                                             Dense
                                             Disabled="@context.Disabled"
                                             Label="@Loc["Ask the user to change this password at next sign-in"]"
                                             @bind-Value="context.Item.RequireChangeAtNextLogin" />
                            </MudStack>
                        </MudAlert>
                    }
                </section>

                @if (!string.IsNullOrEmpty(Key?.ToString()))
                {
                    <section class="user-security-group" aria-label="@Loc["Authenticator App (TOTP)"]" data-testid="user-security-authenticator">
                        <div class="user-security-authenticator-heading">
                            <MudText Typo="Typo.subtitle2">@Loc["Authenticator App (TOTP)"]</MudText>
                            @* Recovery required is separate from not set up: sign-in is blocked until recovery. *@
                            @if (context.Item.MfaRecoveryRequired)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.LockReset" data-testid="user-authenticator-status">@Loc["Recovery required"]</MudChip>
                            }
                            else if (context.Item.TotpEnabled)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Lock" data-testid="user-authenticator-status">@Loc["Enabled"]</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.LockOpen" data-testid="user-authenticator-status">@Loc["Not set up"]</MudChip>
                            }
                        </div>
                        @if (context.Item.MfaRecoveryRequired)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary" data-testid="user-authenticator-recovery-help">
                                @Loc["This user cannot sign in until they recover their authenticator app with a recovery code from an administrator."]
                            </MudText>
                        }
                        @if (CanRecoverAuthenticator(context.Mode) || CanTurnOffMfa(context.Mode, context.Item))
                        {
                            <MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3">
                                @if (CanRecoverAuthenticator(context.Mode))
                                {
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.LockReset"
                                               Disabled="@context.Disabled" OnClick="RecoverAuthenticator" data-testid="user-recover-authenticator">@Loc["Recover authenticator"]</MudButton>
                                }
                                @if (CanTurnOffMfa(context.Mode, context.Item))
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.LockOpen"
                                               Disabled="@context.Disabled" OnClick="TurnOffMfa" data-testid="user-turn-off-mfa">@Loc["Turn off MFA"]</MudButton>
                                }
                            </MudStack>
                        }
                    </section>
                }

                @if (DashboardOptions.StagedAuthority && context.Mode == FormModes.View && !string.IsNullOrEmpty(context.Item.ID))
                {
                    <section class="user-security-group user-security-email" aria-label="@Loc["Email actions"]" data-testid="user-security-email">
                        <MudText Typo="Typo.subtitle2" Class="mb-3">@Loc["Email actions"]</MudText>
                        <ShiftSoftware.ShiftIdentity.Dashboard.Blazor.Pages.UserManager.SecurityEmailAdminActions UserKey="@context.Item.ID" Disabled="@context.Disabled" />
                    </section>
                }
            </div>
        </FormSectionCard>

        <FormSectionCard Title="@Loc["Contacts"]" Icon="@Icons.Material.Filled.ContactMail" data-testid="user-section-contacts">
            <MudGrid Spacing="4">
                <MudItem xs="12" md="6">
                    <div data-testid="user-email">
                        <MudTextField ReadOnly="@context.ReadOnly"
                                      Disabled="@context.Disabled"
                                      OnlyValidateIfDirty="true"
                                      Label="@Loc["Email"]"
                                      @bind-Value="context.Item.Email"
                                      For="@(() => context.Item.Email)" />
                    </div>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField ReadOnly="@context.ReadOnly"
                                  Disabled="@context.Disabled"
                                  OnlyValidateIfDirty="true"
                                  Label="@Loc["Phone"]"
                                  @bind-Value="context.Item.Phone"
                                  For="@(() => context.Item.Phone)" />
                </MudItem>

                @* A full-width notice for a new or changed address: saving an unchanged address never sends anything. *@
                @if (EmailChoiceApplies(context.Item, context.Mode))
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" Dense="true" Icon="@Icons.Material.Filled.MarkEmailUnread" data-testid="user-email-send-verification">
                            <MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="4">
                                <MudText Typo="Typo.body2">@Loc["This address will be saved unverified."]</MudText>
                                <MudCheckBox T="bool"
                                             Dense
                                             Disabled="@context.Disabled"
                                             Label="@Loc["Send a verification link to this address"]"
                                             @bind-Value="context.Item.SendVerification" />
                            </MudStack>
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </FormSectionCard>

        <FormSectionCard Title="@Loc["Permissions"]" Icon="@Icons.Material.Filled.AdminPanelSettings" data-testid="user-section-permissions">
            <HeaderActions>
                @if (!string.IsNullOrEmpty(Key?.ToString()))
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Info"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Policy"
                               OnClick="OpenEffectivePermissions"
                               data-testid="user-effective-permissions">@Loc["View Effective Permissions"]</MudButton>
                }
            </HeaderActions>
            <ChildContent>
                <MudGrid Spacing="4">
                    <MudItem xs="12" md="6">
                        <ShiftAutocomplete Label="@Loc["Access Trees"]"
                                           @bind-Value="LastSelectedAccessTree"
                                           EntitySet="IdentityAccessTree"
                                           TEntitySet="AccessTreeDTO" />
                    </MudItem>

                    @if (context.Item.AccessTrees.Any())
                    {
                        <MudItem xs="12">
                            <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                                @foreach (var item in context.Item.AccessTrees)
                                {
                                    <MudChip T="string" Color="Color.Primary" OnClose="() => RemoveAccessTreetItem(item, context.Mode)">@item.Text</MudChip>
                                }
                            </MudStack>
                        </MudItem>
                    }

                    <MudItem xs="12">
                        @if (ready || context.Mode == FormModes.View || context.Mode == FormModes.Create)
                        {
                            <ActionTree @ref="actionTree" @bind-Tree="context.Item.AccessTree" ReadOnly="@context.ReadOnly" Disabled="@context.Disabled" />
                        }
                    </MudItem>
                </MudGrid>
            </ChildContent>
        </FormSectionCard>
    </MudStack>
</ShiftEntityForm>
}

@code {
    [CascadingParameter] public ShiftSoftware.ShiftIdentity.Blazor.Services.AdmissionUiContext? AdmissionContext { get; set; }
    [Parameter]
    public object? Key { get; set; }

    private UserDTO _theItem = new();
    private bool verificationSendUnconfirmed;

    private ValueTask<bool> HandleSaveResult(ShiftEntityResponse<UserDTO>? result)
    {
        if (result?.Additional?.TryGetValue("EmailVerification", out var delivery) == true)
            verificationSendUnconfirmed = delivery?.ToString() is "Unconfirmed" or "NotRequested";
        return ValueTask.FromResult(true);
    }

    // The generated password must satisfy the shared new-password policy (at least 15 code points).
    private const int GeneratedPasswordLength = 16;

    private bool ready = false;

    private FormModes _mode;

    // The address the form entered edit mode with: the saved one after a fetch, a save or a cancelled edit.
    private string? savedEmail;

    Shared.ActionTree.ActionTree? actionTree;

    List<AccessTreeDTO> accessTress = new List<AccessTreeDTO>();

    protected override void OnInitialized()
    {
        if (_theItem.ID == default)
            _theItem.AccessTree = "{}";
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // The signed-in operator's encoded user ID, the same form as this form's key. An operator cannot issue a recovery
    // code for their own account (the authority refuses it), so the action is not offered on their own user.
    private string? operatorKey;

    // The host's MFA policy, read with the operator's own authenticator status: false where MFA is optional, true
    // where it is mandatory, and null until it is read or when it cannot be read.
    private bool? mfaMandatory;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null) return;
        var user = (await AuthenticationStateTask).User;
        operatorKey = user.FindFirst("sub")?.Value ?? user.FindFirst("nameid")?.Value
            ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (DashboardOptions.StagedAuthority && TypeAuthService.CanAccess(ShiftIdentityActions.ManageMfaRecovery))
            mfaMandatory = await ReadMfaMandatoryAsync();
    }

    // A flow of its own, so this read never makes a dialog's request wait for the shared flow.
    private async Task<bool?> ReadMfaMandatoryAsync()
    {
        var session = Services.GetRequiredService<ShiftSoftware.ShiftIdentity.Blazor.IdentitySession>();
        if (await session.GetTokenAsync() is not { Flow: ShiftSoftware.ShiftIdentity.Core.Enums.AuthPurpose.None, Token: { Length: > 0 } access })
            return null;
        var flow = new ShiftSoftware.ShiftIdentity.Blazor.Services.AuthenticationFlow(
            Services.GetRequiredService<ShiftSoftware.ShiftIdentity.Dashboard.Blazor.Services.StagedAuthorityHttpClient>(), session);
        return await flow.ReadAuthenticatorAsync(access) is ShiftSoftware.ShiftIdentity.Core.Authentication.AuthenticatorStatus status
            ? status.Mandatory : null;
    }

    // Issuing a recovery code is an identity authority action with its own permission, separate from Users write.
    private bool CanRecoverAuthenticator(FormModes mode) =>
        DashboardOptions.StagedAuthority && mode == FormModes.View && !string.IsNullOrEmpty(Key?.ToString()) &&
        !string.Equals(operatorKey, Key?.ToString(), StringComparison.Ordinal) &&
        TypeAuthService.CanAccess(ShiftIdentityActions.ManageMfaRecovery);

    // Turning MFA off has the same guard as a recovery code, applies only where MFA is optional, and only to a user
    // who has an authenticator or waits for recovery.
    private bool CanTurnOffMfa(FormModes mode, UserDTO item) =>
        CanRecoverAuthenticator(mode) && mfaMandatory == false && (item.TotpEnabled || item.MfaRecoveryRequired);

    private async Task TurnOffMfa()
    {
        var key = Key?.ToString();
        if (string.IsNullOrEmpty(key)) return;
        var parameters = new DialogParameters<ShiftSoftware.ShiftIdentity.Dashboard.Blazor.Pages.UserManager.MfaTurnOffAdminForm>
        {
            { x => x.UserKey, key },
            { x => x.UserName, string.IsNullOrWhiteSpace(_theItem.FullName) ? _theItem.Username : $"{_theItem.FullName} ({_theItem.Username})" },
            { x => x.RecoveryRequired, _theItem.MfaRecoveryRequired }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true, CloseButton = false,
            BackdropClick = false, CloseOnEscapeKey = false };
        var dialog = await DialogService.ShowAsync<ShiftSoftware.ShiftIdentity.Dashboard.Blazor.Pages.UserManager.MfaTurnOffAdminForm>("", parameters, options);
        var result = await dialog.Result;
        // MFA is off: show the saved state now; the next load of the user reads the same state from the server.
        if (result is { Canceled: false, Data: true } && Key?.ToString() == key)
        {
            _theItem.TotpEnabled = false;
            _theItem.MfaRecoveryRequired = false;
        }
    }

    private async Task RecoverAuthenticator()
    {
        var key = Key?.ToString();
        if (string.IsNullOrEmpty(key)) return;
        var parameters = new DialogParameters<ShiftSoftware.ShiftIdentity.Dashboard.Blazor.Pages.UserManager.MfaRecoveryAdminForm>
        {
            { x => x.Dialog, true },
            { x => x.UserKey, key },
            { x => x.UserName, string.IsNullOrWhiteSpace(_theItem.FullName) ? _theItem.Username : $"{_theItem.FullName} ({_theItem.Username})" }
        };
        // A narrow dialog that stays open on a backdrop click or Escape, so a shown code is not lost by accident.
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true, CloseButton = false,
            BackdropClick = false, CloseOnEscapeKey = false };
        var dialog = await DialogService.ShowAsync<ShiftSoftware.ShiftIdentity.Dashboard.Blazor.Pages.UserManager.MfaRecoveryAdminForm>("", parameters, options);
        var result = await dialog.Result;
        // A code was issued, so the authority has turned the authenticator off and requires recovery. Show that
        // saved state now; the next load of the user reads the same state from the server.
        if (result is { Canceled: false, Data: true } && Key?.ToString() == key)
        {
            _theItem.MfaRecoveryRequired = true;
            _theItem.TotpEnabled = false;
        }
    }

    private void ModeChanged(FormModes mode)
    {
        _mode = mode;

        if (mode == FormModes.Edit)
            savedEmail = _theItem.Email;
    }

    // Mirrors the upsert hook: the forced change is written only when a password is supplied.
    private static bool PasswordChoiceApplies(UserDTO item, FormModes mode) =>
        mode >= FormModes.Edit && !string.IsNullOrEmpty(item.Password);

    // Mirrors the upsert hook: a link goes only to a created user's address or an address that differs from the saved
    // one, compared case-insensitively without trimming.
    private bool EmailChoiceApplies(UserDTO item, FormModes mode) =>
        mode >= FormModes.Edit
        && !string.IsNullOrWhiteSpace(item.Email)
        && !string.Equals(item.Email, savedEmail, StringComparison.OrdinalIgnoreCase);

    public ShiftSoftware.ShiftEntity.Model.Dtos.ShiftEntitySelectDTO? LastSelectedAccessTree
    {
        get { return null; }
        set
        {
            var currentList = _theItem.AccessTrees.ToList();

            if (!currentList.Any(x => x.Value.Equals(value!.Value)))
            {
                currentList.Add(value!);
            }

            _theItem.AccessTrees = currentList;
        }
    }

    public void RemoveAccessTreetItem(ShiftSoftware.ShiftEntity.Model.Dtos.ShiftEntitySelectDTO item, FormModes mode)
    {
        if (mode <= ShiftBlazor.Enums.FormModes.Archive)
            return;

        _theItem.AccessTrees = _theItem.AccessTrees.Where(x => !x.Value.Equals(item.Value)).ToList();
    }

    private async Task OpenEffectivePermissions()
    {
        var key = Key?.ToString();

        if (string.IsNullOrEmpty(key))
            return;

        var parameters = new DialogParameters<EffectivePermissionsDialog>();
        parameters.Add(x => x.Key, key);

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

        await DialogService.ShowAsync<EffectivePermissionsDialog>(Loc["Effective Permissions"], parameters, options);
    }
}
