@attribute [Route($"{Constants.IdentityRoutePreifix}/Preview/Email/{{Screen}}")]
@layout Shared.BareLayout
@using ShiftSoftware.ShiftIdentity.Core.Authentication
@inject ShiftIdentityDashboardBlazorOptions Options
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

@* The email the authority sends for each link page, composed by the same SecurityEmailLayout, with sample account
   fields. Its button opens that page's preview, as the real one opens the page. *@
@if (!Options.EnablePreviewPages || Purpose is null)
{
    <p class="email-preview-off">@(Options.EnablePreviewPages ? "There is no email preview for this page." : "Preview pages are turned off for this host.")</p>
}
else
{
    var body = Body();
    <div class="email-preview">
        <header class="email-preview-envelope">
            <div><span>From</span>@(Options.Title ?? "Identity")</div>
            <div><span>To</span>@Sample.Email</div>
            <div><span>Subject</span><strong>@body.Subject</strong></div>
        </header>
        <div class="email-preview-frame @(mobile ? "mobile" : null)">
            @if (text)
            {
                <pre class="email-preview-text">@body.TextBody</pre>
            }
            else
            {
                @* No scripts in the message. A pressed link opens in this tab, as from a mail client. *@
                <iframe @ref="frame" title="@body.Subject" sandbox="allow-same-origin allow-top-navigation-by-user-activation"
                        srcdoc="@body.HtmlBody.Replace("<head>", "<head><base target=\"_top\">")"></iframe>
            }
        </div>
    </div>
    <nav class="identity-preview-bar" aria-label="Email preview">
        <a href="@($"{Constants.IdentityRoutePreifix}/Preview")">Preview</a>
        <a href="@Link(nameof(ResetPassword))" aria-current="@(Screen == nameof(ResetPassword) ? "page" : null)">Reset email</a>
        <a href="@Link(nameof(VerifyEmail))" aria-current="@(Screen == nameof(VerifyEmail) ? "page" : null)">Verify email</a>
        <span></span>
        <button type="button" aria-pressed="@Pressed(mobile)" @onclick="() => mobile = !mobile">Mobile</button>
        <button type="button" aria-pressed="@Pressed(text)" @onclick="() => text = !text">Plain text</button>
        <button type="button" aria-pressed="@Pressed(logo)" @onclick="() => logo = !logo">Logo</button>
        <button type="button" aria-pressed="@Pressed(expiry)" @onclick="() => expiry = !expiry">Expiry</button>
        <button type="button" aria-pressed="@Pressed(longName)" @onclick="() => longName = !longName">Long name</button>
    </nav>
}

<style>
    .email-preview-off { padding: 24px; font: 14px system-ui, sans-serif; }
    .email-preview { min-height: 100vh; padding: 24px 16px 72px; background: #e9edf2; font: 14px/1.4 system-ui, sans-serif; color: #1f2937; }
    .email-preview-envelope { max-width: 760px; margin: 0 auto 12px; padding: 12px 16px; border-radius: 8px; background: #fff; }
    .email-preview-envelope div { display: flex; gap: 12px; padding: 2px 0; overflow-wrap: anywhere; }
    .email-preview-envelope span { flex: 0 0 64px; color: #6b7280; }
    .email-preview-frame { max-width: 760px; margin: 0 auto; border-radius: 8px; overflow: hidden; background: #fff; box-shadow: 0 1px 3px #0000001f; }
    .email-preview-frame.mobile { max-width: 375px; }
    .email-preview-frame iframe { display: block; width: 100%; height: 760px; border: 0; }
    .email-preview-text { margin: 0; padding: 24px; white-space: pre-wrap; overflow-wrap: anywhere; font: 13px/1.6 ui-monospace, Consolas, monospace; }
    .identity-preview-bar { position: fixed; inset-inline-start: 12px; bottom: 12px; z-index: 2000; display: flex; flex-wrap: wrap; align-items: center; gap: 4px; max-width: calc(100vw - 24px); padding: 6px; border-radius: 6px; background: #1f2937e6; font: 12px/1.2 system-ui, sans-serif; }
    .identity-preview-bar a, .identity-preview-bar button { padding: 5px 8px; border: 0; border-radius: 4px; background: transparent; color: #e5e7eb; font: inherit; text-decoration: none; cursor: pointer; }
    .identity-preview-bar a:hover, .identity-preview-bar button:hover { background: #ffffff26; }
    .identity-preview-bar a[aria-current], .identity-preview-bar button[aria-pressed="true"] { background: #fff; color: #111827; }
    .identity-preview-bar span { width: 1px; align-self: stretch; margin: 2px 4px; background: #ffffff40; }
</style>

@code {
    [Parameter] public string Screen { get; set; } = "";
    private bool mobile, text, logo = true, expiry = true, longName;
    private ElementReference frame;
    private IJSObjectReference? module;

    private static readonly (string Email, string FullName, string LongName, string Username) Sample =
        ("aza.asim@example.com", "Aza Asim", "Aza Asim Abdulrahman Mohammed Al-Karadaghi", "aza.asim");

    private AuthenticationOperationPurpose? Purpose => Screen switch
    {
        nameof(ResetPassword) => AuthenticationOperationPurpose.PasswordResetEmail,
        nameof(VerifyEmail) => AuthenticationOperationPurpose.EmailVerify,
        _ => null
    };

    private static string Link(string screen) => $"{Constants.IdentityRoutePreifix}/Preview/Email/{screen}";
    private static string Pressed(bool on) => on ? "true" : "false";

    private SecurityEmailBody Body() => SecurityEmailLayout.Compose(new(Purpose!.Value,
        longName ? Sample.LongName : Sample.FullName, Sample.Username,
        Navigation.ToAbsoluteUri(SecurityLinkPreview.Link(Screen, PreviewState.Ready)).AbsoluteUri,
        // A sample deadline; off shows the wording for a link without one.
        expiry ? DateTimeOffset.UtcNow.AddHours(1) : null)
    {
        LogoSource = logo && !string.IsNullOrWhiteSpace(Options.LogoPath) ? Navigation.ToAbsoluteUri(Options.LogoPath).AbsoluteUri : null
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The frame takes the message's height, so the page scrolls as one inbox view.
        if (text || frame.Context is null) return;
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ShiftSoftware.ShiftIdentity.Dashboard.Blazor/email-preview.js");
            await module.InvokeVoidAsync("fit", frame);
        }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null) return;
        try { await module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
