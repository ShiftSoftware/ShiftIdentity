@attribute [Authorize]
@layout Shared.DefaultLayout
@attribute [Route($"{Constants.IdentityRoutePreifix}/{nameof(BrandForm)}/{{Key?}}")]
@inject HttpClient Http
@inject ShiftIdentityLocalizer Loc


<ShiftEntityForm @bind-Value="_theItem"
                 Endpoint="@($"{Constants.IdentityRoutePreifix}Brand")"
                 Title="@Loc["Brand"]"
                 @bind-Key="@Key"
                 AllowSaveAsNew
                 TypeAuthAction="ShiftIdentityActions.Brands"
                 T="ShiftSoftware.ShiftIdentity.Core.DTOs.Brand.BrandDTO">

    <LocalizedTextField @bind-Value="context.Item.Name" Label="@Loc["Name"]" For="() => context.Item.Name" />

    <MudTextFieldExtended @bind-Value="context.Item.IntegrationId" Label="@Loc["Integration ID"]" For="() => context.Item.IntegrationId" />
</ShiftEntityForm>

@code {
    [Parameter]
    public object? Key { get; set; }

    private ShiftSoftware.ShiftIdentity.Core.DTOs.Brand.BrandDTO _theItem = new();

    [Parameter]
    public string? BrandName { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(BrandName))
        {
            _theItem.Name = BrandName;
        }
    }
}