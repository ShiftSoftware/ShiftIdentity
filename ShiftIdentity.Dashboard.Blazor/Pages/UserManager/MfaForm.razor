@attribute [Authorize]
@layout Shared.DefaultLayout
@attribute [Route($"{Constants.IdentityRoutePreifix}/{nameof(MfaForm)}")]
@inject ShiftModal ShiftModal
@inject MessageService Message
@inject AuthService AuthService
@inject NavigationManager NavManager
@inject ShiftIdentityLocalizer Loc
@inject IIdentityStore storageService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using ShiftSoftware.ShiftIdentity.Blazor
@using AuthenticationFlow = ShiftSoftware.ShiftIdentity.Blazor.Services.AuthenticationFlow
@using ShiftSoftware.ShiftIdentity.Core.Authentication

<MudPaper Elevation="25" Class="pa-5">

    <EditForm Model="@dto" OnValidSubmit="VerifyMfa">
        <DataAnnotationsValidator />

        <MudText>@Loc["Enter the code from your two-factor authentication app or browser extension below"]</MudText>

        <MudTextField T="string" Label="@Loc["Code"]" @bind-Value="dto.Code"
                      Immediate="@(AdmissionFlow is not null)"
                      For="@(() => dto.Code)" InputType="InputType.Text" InputMode="InputMode.numeric" autocomplete="one-time-code" />

        <br />
        <br />

        <MudGrid Justify="Justify.FlexEnd">
            @if (MudDialog is not null)
            {
                <MudButton StartIcon="@Icons.Material.Filled.Cancel" OnClick="() => Cancel()">@Loc["Cancel"]</MudButton>
            }

            <MudButton Disabled="@(AdmissionFlow?.Busy ?? false)" Color="Color.Primary" ButtonType="ButtonType.Submit">
                <MudIcon Icon="@Icons.Material.Filled.Save" />
                <MudText Style="padding:0 10px;">@Loc["Verify"]</MudText>
            </MudButton>
        </MudGrid>
    </EditForm>
</MudPaper>

@code {
    [Parameter] public AuthenticationFlow? AdmissionFlow { get; set; }
    [Parameter] public EventCallback<AuthOutcome> AdmissionCompleted { get; set; }
    private MfaDTO dto = new ();

    [CascadingParameter]
    protected IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private Task Cancel()
    {
        if (MudDialog is not null)
            ShiftModal.Close(MudDialog);

        return Task.CompletedTask;
    }

    private async Task VerifyMfa()
    {
        if (AdmissionFlow is not null)
        {
            var outcome = await AdmissionFlow.CompleteMfaAsync(dto.Code);
            dto.Code = string.Empty;
            await AdmissionCompleted.InvokeAsync(outcome);
            return;
        }
        try
        {
            var result = await AuthService.VerifyMfaAsync(dto);

            if (!result.IsSuccess || result.Data?.Entity is null)
            {
                var body = result?.Data?.Message?.Body;
                Message.Error(string.IsNullOrWhiteSpace(body) ? Loc["Invalid code"] : body, result?.Data?.Message?.Title);

                return;
            }

            await storageService.StoreTokenAsync(result.Data.Entity);

            //Notify AuthenticationStateProvider and TypeAuth that auth state has changed
            await AuthenticationStateProvider.GetAuthenticationStateAsync();


            if (MudDialog is not null)
            {
                ShiftModal.Close(MudDialog);
                return;
            }

            NavManager.NavigateTo(ReturnUrl ?? "/", true);
        }
        catch (Exception)
        {
            Message.Error(Loc["Your session has expired. Please log in again."]);
        }
    }
}
