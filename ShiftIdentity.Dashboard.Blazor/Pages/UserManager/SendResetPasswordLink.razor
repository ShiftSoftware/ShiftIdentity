@attribute [Route($"{Constants.IdentityRoutePreifix}/{nameof(SendResetPasswordLink)}")]
@layout Shared.LoginLayout
@using AuthenticationFlow = ShiftSoftware.ShiftIdentity.Blazor.Services.AuthenticationFlow
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@inject ShiftIdentityDashboardBlazorOptions Options
@inject NavigationManager NavManager

<LoginBox ViewKey="@(requested ? "reset:sent" : "reset")" CanGoBack="true" Back="Back">
    @if (LinkFlow is not null) { <SecurityEmailRequestForm Flow="LinkFlow" Embedded="true" ReturnToLogin="Back" RequestCompleted="() => requested = true" /> }
    else { <LegacyResetRequestForm ReturnToLogin="Back" RequestCompleted="() => requested = true" /> }
</LoginBox>

@code {
    [CascadingParameter] public ShiftSoftware.ShiftIdentity.Blazor.Services.AdmissionUiContext? AdmissionContext { get; set; }
    private AuthenticationFlow? LinkFlow => AdmissionContext?.Flow ?? (Options.StagedAuthority ? Services.GetRequiredService<AuthenticationFlow>() : null);
    private bool requested;
    private void Back() => NavManager.NavigateTo($"{Constants.IdentityRoutePreifix}/login");
}
