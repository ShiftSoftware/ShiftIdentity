@using ShiftSoftware.ShiftIdentity.Blazor.Services
@using ShiftSoftware.ShiftIdentity.Core.Authentication

<MudPaper Class="pa-5">
    <MudText Typo="Typo.h5">@(Administrator ? "User security" : "Profile")</MudText>
    @if (account is not null)
    {
        <MudText Typo="Typo.h6">@account.FullName</MudText>
        <MudText>@account.Username</MudText>
        <MudText>Authenticator: @(account.RecoveryRequired ? "Recovery required" : account.HasAuthenticator ? "Enabled" : "Not set up")</MudText>
        <MudText>Email: @(account.Email ?? "Not set") @(account.Email is null ? "" : account.EmailVerified ? "(verified)" : "(unverified)")</MudText>
        @if (!Administrator)
        {
            <MudButton Color="Color.Primary" Href="Identity/ChangePasswordForm">Change Password</MudButton>
            <MudButton Color="Color.Primary" Href="Identity/TotpEnrollmentForm">@(account.HasAuthenticator ? "Replace authenticator" : "Set up authenticator")</MudButton>
            <MudButton Href="Identity/SendResetPasswordLink">Reset password by email</MudButton>
            @if (account.Email is not null && (!account.EmailVerified || !account.RecoveryEmailEligible))
            {
                <MudButton OnClick="VerifyCurrentEmail" Disabled="Context.Flow.Busy">Send email verification link</MudButton>
            }
        }
        else if (actor?.CanManageRecovery == true && actor.UserID != account.UserID && access is not null)
        {
            <MfaRecoveryAdminForm AdmissionFlow="Context.Flow" AccessToken="@access" UserID="account.UserID" AdmissionCompleted="RecoveryIssued" />
        }
        @if (Administrator && access is not null)
        {
            @if (actor?.CanManagePasswordReset == true)
            {
                <MudButton OnClick="() => ResetPassword(false)" Disabled="Context.Flow.Busy">Send password reset email</MudButton>
                <MudButton OnClick="() => ResetPassword(true)" Disabled="Context.Flow.Busy">Create manual password reset link</MudButton>
            }
            @if (actor?.CanManageEmailVerification == true && account.Email is not null && (!account.EmailVerified || !account.RecoveryEmailEligible))
            {
                <MudButton OnClick="VerifyAdminEmail" Disabled="Context.Flow.Busy">Send email verification link</MudButton>
            }
        }
        @if (manual is not null)
        {
            <MudAlert Severity="Severity.Info">Share this private link with the user through your approved channel. They choose their password. This link does not verify their email or recover their authenticator.</MudAlert>
            <MudTextField T="string" Label="Private password reset link" ReadOnly="true" Value="@ManualLink" data-testid="manual-reset-link" />
            <MudButton Href="@ManualLink" Target="_blank" rel="noreferrer">Open password reset link</MudButton>
            <MudText>Expires @manual.ExpiresAt.ToString("u")</MudText>
        }
        @if (message is not null) { <MudAlert Severity="Severity.Info" data-testid="account-delivery-result">@message</MudAlert> }
        <MudAlert Severity="Severity.Info" Class="mt-4">Profile, contact and permission editing are unavailable in this isolated authentication mode.</MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Info">@(loading ? "Loading account…" : "This account is unavailable or you do not have permission to view it.")</MudAlert>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public AdmissionUiContext Context { get; set; } = null!;
    [Parameter] public string? UserKey { get; set; }
    [Parameter] public bool Administrator { get; set; }
    private AdmissionAccount? account, actor;
    private string? access;
    private bool loading;
    private long loadGeneration;
    private AdmissionUiContext? loadedContext;
    private string? loadedKey;
    private bool loadedAdministrator;
    [Inject] private NavigationManager Navigation { get; set; } = null!;
    private ManualPasswordResetIssued? manual;
    private string? message;
    private string? ManualLink => manual is null ? null : Navigation.ToAbsoluteUri(SecurityLinkNavigation.ResetLink(manual.Grant)).ToString();
    private async Task<string?> CurrentAccess() => (await Context.Store.GetTokenAsync())?.Token;
    private void DeliveryResult(AuthOutcome result, bool manualDelivery = false) => message = result switch
    {
        SecurityDeliveryRequested => "If this account is eligible, check its saved email inbox. If no link arrives, wait before trying again.",
        AuthenticationRefused { Code: AuthenticationFailure.Unavailable } => manualDelivery
            ? "The link could not be created. Please wait and try again."
            : "We could not confirm that the email was sent. Check the saved email inbox, then wait before trying again.",
        _ => "The request could not be completed. Sign in again and check your permission before retrying."
    };
    private async Task VerifyCurrentEmail()
    {
        message = null;
        var request = loadGeneration;
        if (await CurrentAccess() is { } token)
        {
            var result = await Context.Flow.RequestCurrentEmailVerificationAsync(token);
            if (request == loadGeneration) DeliveryResult(result);
        }
        else if (request == loadGeneration) message = "Sign in again before requesting verification.";
    }
    private async Task VerifyAdminEmail()
    {
        message = null;
        var request = loadGeneration; var target = account;
        if (target is not null && await CurrentAccess() is { } token)
        {
            var result = await Context.Flow.RequestAdminEmailVerificationAsync(token, target.UserID);
            if (request == loadGeneration) DeliveryResult(result);
        }
        else if (request == loadGeneration) message = "Sign in again before requesting verification.";
    }
    private async Task ResetPassword(bool manualDelivery)
    {
        manual = null; message = null;
        var request = loadGeneration; var target = account;
        if (target is null || await CurrentAccess() is not { } token)
        {
            if (request == loadGeneration) message = "Sign in again before requesting a password reset.";
            return;
        }
        var result = await Context.Flow.RequestAdminPasswordResetAsync(token, target.UserID, manualDelivery);
        if (request != loadGeneration) return;
        if (result is ManualPasswordResetIssued issued) manual = issued;
        else if (manualDelivery && result is SecurityDeliveryRequested) message = "Please wait before creating another link.";
        else DeliveryResult(result, manualDelivery);
    }
    private void RecoveryIssued(AuthOutcome result)
    {
        if (result is MfaRecoveryCodeIssued && account is not null)
            account = account with { HasAuthenticator = false, RecoveryRequired = true };
    }
    protected override async Task OnParametersSetAsync()
    {
        // Background renewal must not reset an operator's verification entry or displayed recovery code.
        if (ReferenceEquals(loadedContext, Context) && loadedKey == UserKey && loadedAdministrator == Administrator) return;
        loadedContext = Context; loadedKey = UserKey; loadedAdministrator = Administrator;
        var request = ++loadGeneration;
        account = null; actor = null; access = null; loading = true; manual = null; message = null;
        try
        {
            if (Administrator && (!long.TryParse(UserKey, out var id) || id <= 0)) return;
            var current = await Context.AccountAsync();
            var target = Administrator ? await Context.AccountAsync(long.Parse(UserKey!)) : current;
            var token = (await Context.Store.GetTokenAsync())?.Token;
            if (request == loadGeneration) { actor = current; account = target; access = token; }
        }
        catch (HttpRequestException) { }
        finally { if (request == loadGeneration) loading = false; }
    }
}
