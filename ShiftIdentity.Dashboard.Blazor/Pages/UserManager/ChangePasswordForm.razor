@attribute [Authorize]
@layout Shared.DefaultLayout
@attribute [Route($"{Constants.IdentityRoutePreifix}/{nameof(ChangePasswordForm)}")]
@inject ShiftModal ShiftModal
@inject MessageService Message
@inject UserManagerService UserManager
@inject AuthService AuthService
@inject NavigationManager NavManager
@inject HttpClient http
@inject ShiftIdentityLocalizer Loc
@inject IIdentityStore storageService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using ShiftSoftware.ShiftIdentity.Blazor
@using MudBlazor
@using ShiftSoftware.ShiftIdentity.Core
@using ShiftSoftware.ShiftIdentity.Core.Authentication
@using System.ComponentModel.DataAnnotations
@using AuthenticationFlow = ShiftSoftware.ShiftIdentity.Blazor.Services.AuthenticationFlow

@if (AdmissionFlow is not null)
{
    <MudPaper Class="pa-5" data-testid="password-change-form">
        @if (AdmissionFlow.Pending is { Step: AuthenticationStep.ExistingMfa })
        {
            <MfaForm AdmissionFlow="AdmissionFlow" AdmissionCompleted="HandleAdmission" />
        }
        else if (AdmissionFlow.Pending is { Step: AuthenticationStep.Password, Handle: not null })
        {
            <MudText Typo="Typo.h6">@Loc["Confirm your current password"]</MudText>
            <EditForm Model="currentEntry" OnValidSubmit="ProveCurrentPassword">
                <DataAnnotationsValidator />
                <MudTextField T="string" Label="@Loc["Current Password"]" @bind-Value="currentEntry.Password"
                              For="@(() => currentEntry.Password)" Immediate="true" InputType="InputType.Password" />
                <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Disabled="AdmissionFlow.Busy">@Loc["Continue"]</MudButton>
            </EditForm>
        }
        else if (AdmissionFlow.Pending is { Step: AuthenticationStep.PasswordChange, Handle: not null })
        {
            <MudText Typo="Typo.h6">@Loc["Choose a new password"]</MudText>
            <MudText>@NewPasswordPolicy.Guidance</MudText>
            <EditForm Model="newEntry" OnValidSubmit="SaveAdmissionPassword">
                <DataAnnotationsValidator />
                <MudTextField T="string" Label="@Loc["New Password"]" @bind-Value="newEntry.Password"
                              For="@(() => newEntry.Password)" Immediate="true" InputType="InputType.Password" />
                <MudTextField T="string" Label="@Loc["Confirm Password"]" @bind-Value="newEntry.Confirm"
                              For="@(() => newEntry.Confirm)" Immediate="true" InputType="InputType.Password" />
                <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Disabled="AdmissionFlow.Busy">@Loc["Change password"]</MudButton>
            </EditForm>
        }
        else if (AdmissionFlow.Pending is { } pending)
        {
            <MudAlert Severity="Severity.Info" data-testid="restricted-step">
                @(AdmissionFlow.PasswordWasChanged ? Loc["Password changed. Additional account verification is required before signing in."]
                    : Loc["Additional account verification is required before the password can be changed."])
                @pending.Step
            </MudAlert>
        }
        @if (admissionError is not null)
        {
            <MudAlert Severity="Severity.Error" data-testid="password-error">@admissionError</MudAlert>
        }
    </MudPaper>
}
else
{
<MudPaper Elevation="25" Class="pa-5">
    @if (Enforce)
    {
        <MudAlert Severity="Severity.Info">@Loc["You must change your password"]</MudAlert>
    }

    <EditForm Model="@dto" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <MudTextField T="string" Label="@Loc["Current Password"]" @bind-Value="dto.CurrentPassword"
                      For="@(() => dto.CurrentPassword)" InputType="InputType.Password" />

        <MudTextField T="string" Label="@Loc["New Password"]" HelperText="@Loc["Choose a strong password"]" @bind-Value="dto.NewPassword"
                      For="@(() => dto.NewPassword)" InputType="@newPasswordInputType"
                      Adornment="Adornment.End"
                      AdornmentIcon="@GetNewPasswordAdornmentIcon()"
                      OnAdornmentClick="@OnNewPasswordAdornmentClick"
                      AdornmentAriaLabel="@GetNewPasswordAdornmentAriaLabel()" />

        <MudTextField T="string" Label="@Loc["Confirm Password"]" @bind-Value="dto.ConfirmPassword"
                      For="@(() => dto.ConfirmPassword)" InputType="InputType.Password" />

        <br />
        <br />

        <MudGrid Justify="Justify.FlexEnd">
            @if (MudDialog is not null)
            {
                <MudButton StartIcon="@Icons.Material.Filled.Cancel" OnClick="() => Cancel()">@Loc["Cancel"]</MudButton>
            }

            <MudButton Color="Color.Primary" ButtonType="ButtonType.Submit">
                <MudIcon Icon="@Icons.Material.Filled.Save" />
                <MudText Style="padding:0 10px;">@Loc["Save"]</MudText>
            </MudButton>
        </MudGrid>
    </EditForm>
</MudPaper>
}

@code {
    [Parameter] public AuthenticationFlow? AdmissionFlow { get; set; }
    [Parameter] public EventCallback<AuthOutcome> AdmissionCompleted { get; set; }
    private CurrentPasswordEntry currentEntry = new();
    private NewPasswordEntry newEntry = new();
    private string? admissionError;
    private sealed class CurrentPasswordEntry { [Required] public string Password { get; set; } = ""; }
    private sealed class NewPasswordEntry
    {
        [Required] public string Password { get; set; } = "";
        [Required, Compare(nameof(Password), ErrorMessage = "Passwords must match.")] public string Confirm { get; set; } = "";
    }
    private async Task ProveCurrentPassword()
    {
        var result = await AdmissionFlow!.ProvePasswordAsync(currentEntry.Password);
        currentEntry = new();
        await HandleAdmission(result);
    }
    private async Task SaveAdmissionPassword()
    {
        var result = await AdmissionFlow!.ChangePasswordAsync(newEntry.Password);
        newEntry = new();
        await HandleAdmission(result);
    }
    private async Task HandleAdmission(AuthOutcome result)
    {
        admissionError = result switch
        {
            AuthenticationRefused { Code: AuthenticationFailure.InvalidNewPassword, PasswordFailure: var reason } =>
                reason == PasswordPolicyFailure.SameAsCurrent ? "Choose a password different from your current password."
                : reason == PasswordPolicyFailure.Blocked ? "This password is too common or based on your username. Choose another."
                : NewPasswordPolicy.Guidance,
            AuthenticationRefused { Code: AuthenticationFailure.InvalidProof } => "That password or code was not accepted. Try again.",
            AuthenticationRefused => "The operation could not be completed. Sign in again to check your password; a lost response may follow a completed change.",
            _ => null
        };
        await AdmissionCompleted.InvokeAsync(result);
    }
    private ChangePasswordDTO dto = new ChangePasswordDTO();

    [CascadingParameter]
    protected IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public bool Enforce { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private bool showNewPassword = false;
    private InputType newPasswordInputType => showNewPassword ? InputType.Text : InputType.Password;

    private string GetNewPasswordAdornmentIcon()
    {
        if (string.IsNullOrEmpty(dto.NewPassword))
            return Icons.Material.Filled.VpnKey;
        else
            return showNewPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }
    private string GetNewPasswordAdornmentAriaLabel()
    {
        if (string.IsNullOrEmpty(dto.NewPassword))
            return "Generate Password";
        else
            return showNewPassword ? "Hide Password" : "Show Password";
    }
    private void OnNewPasswordAdornmentClick()
    {
        if (string.IsNullOrEmpty(dto.NewPassword))
        {
            dto.NewPassword = PasswordGenerator.GeneratePassword(8);
            showNewPassword = true;
        }
        else
        {
            showNewPassword = !showNewPassword;
        }
    }

    private Task Cancel()
    {
        if (MudDialog is not null)
            ShiftModal.Close(MudDialog);

        return Task.CompletedTask;
    }

    private async Task Save()
    {
        try
        {
            var result = await UserManager.ChangePasswordAsync(dto);

            if (!result.IsSuccess)
            {
                Message.Error(result?.Data?.Message?.Body!, result?.Data?.Message?.Title);
                return;
            }

            await storageService.StoreTokenAsync(result?.Data?.Entity!);

            //Notify AuthenticationStateProvider and TypeAuth that auth state has changed
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

            if (MudDialog is not null)
            {
                ShiftModal.Close(MudDialog);
                return;
            }

            NavManager.NavigateTo(ReturnUrl ?? "/", true);
        }
        catch (Exception)
        {
            Message.Error(Loc["Your session has expired. Please log in again."]);
        }
    }
}
