@attribute [Authorize]
@layout Shared.DefaultLayout
@attribute [Route($"{Constants.IdentityRoutePreifix}/{nameof(ChangePasswordForm)}")]
@inject ShiftModal ShiftModal
@inject MessageService Message
@inject UserManagerService UserManager
@inject AuthService AuthService
@inject NavigationManager NavManager
@inject HttpClient http
@inject ShiftIdentityLocalizer Loc
@inject IdentitySession storageService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ShiftIdentityDashboardBlazorOptions DashboardOptions
@inject IServiceProvider Services
@using Microsoft.Extensions.DependencyInjection
@using ShiftSoftware.ShiftIdentity.Blazor
@using MudBlazor
@using ShiftSoftware.ShiftIdentity.Core
@using ShiftSoftware.ShiftIdentity.Core.Authentication
@using ShiftSoftware.ShiftIdentity.Core.Enums
@using System.ComponentModel.DataAnnotations
@using AuthenticationFlow = ShiftSoftware.ShiftIdentity.Blazor.Services.AuthenticationFlow

@if (AdmissionFlow is not null || deciding)
{
    @* Opened from the profile (or its own route), this form owns the change and shows its steps in the login-box look,
       sliding from one to the next; the close button cancels the change. As a step of a sign-in it is already inside
       the sign-in box, which slides and cancels for it. *@
    <SecurityStepBox Boxed="@OwnsBox" ViewKey="@StepKey" Caption="@Loc["Change Password"]" Close="CloseOwned" CloseDisabled="@(deciding || (AdmissionFlow?.Busy ?? true))">
        @if (deciding || AdmissionFlow is null)
        {
            <div class="d-flex justify-center pa-8" data-testid="password-change-loading">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <div data-testid="password-change-form">
                @if (completed)
                {
                    <div class="auth-center" role="status" data-testid="password-change-done">
                        <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" Size="Size.Large" Class="auth-done-icon" />
                        <h1 class="auth-title" tabindex="-1">@Loc["Password changed"]</h1>
                        <p class="auth-description">@Loc["You are still signed in on this device. Other devices will need to sign in again."]</p>
                        <div class="auth-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Finish" data-testid="password-change-finish">@Loc["Done"]</MudButton></div>
                    </div>
                }
                else if (AdmissionFlow.Pending is { Step: AuthenticationStep.NewMfa })
                {
                    <TotpEnrollmentForm AdmissionFlow="AdmissionFlow" AdmissionCompleted="HandleEnrollment" />
                }
                else if (AdmissionFlow.Pending is { Step: AuthenticationStep.ExistingMfa })
                {
                    <MfaForm AdmissionFlow="AdmissionFlow" AdmissionCompleted="HandleAdmission"
                             Title="Confirm it's you" Description="Enter the 6-digit code from your authenticator app before you choose a new password." />
                }
                else if (AdmissionFlow.Pending is { Step: AuthenticationStep.Password, Handle: not null })
                {
                    <h1 class="auth-title" tabindex="-1">@Loc["Confirm your current password"]</h1>
                    <p class="auth-description">@Loc["Enter the password you use now. Then you can choose a new one."]</p>
                    <AuthForm Model="currentEntry" Submit="ProveCurrentPassword" class="auth-inputs" Context="attempting">
                        <PasswordField Label="@Loc["Current Password"]" @bind-Value="currentEntry.Password"
                                       For="@(() => currentEntry.Password)" Immediate="true" autocomplete="current-password" />
                        <div class="auth-actions">
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(attempting || AdmissionFlow.Busy)">@Loc["Continue"]</MudButton>
                        </div>
                    </AuthForm>
                }
                else if (AdmissionFlow.Pending is { Step: AuthenticationStep.PasswordChange, Handle: not null })
                {
                    <h1 class="auth-title" tabindex="-1">@Loc["Choose a new password"]</h1>
                    <p class="auth-description">@Loc[NewPasswordPolicy.Guidance]</p>
                    <AuthForm Model="newEntry" Submit="SaveAdmissionPassword" class="auth-inputs" Context="attempting">
                        <PasswordField Label="@Loc["New Password"]" @bind-Value="newEntry.Password"
                                       For="@(() => newEntry.Password)" Immediate="true" autocomplete="new-password" />
                        <PasswordField Label="@Loc["Confirm Password"]" @bind-Value="newEntry.Confirm"
                                       For="@(() => newEntry.Confirm)" Immediate="true" autocomplete="new-password" />
                        <div class="auth-actions">
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(attempting || AdmissionFlow.Busy)">@Loc["Change Password"]</MudButton>
                        </div>
                    </AuthForm>
                }
                else if (AdmissionFlow.Pending is { } pending)
                {
                    <MudAlert Severity="Severity.Info" data-testid="restricted-step" data-step="@pending.Step">
                        @(AdmissionFlow.PasswordWasChanged ? Loc["Password changed. Additional account verification is required before signing in."]
                            : Loc["Additional account verification is required before the password can be changed."])
                    </MudAlert>
                }
                <AuthError @bind-Message="admissionError" TestId="password-error" />
                @if (OwnsBox && !completed && AdmissionFlow.Pending is null)
                {
                    @* Nothing is pending after a refusal: the change has ended, and closing is the only way on. *@
                    <div class="auth-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseOwned" data-testid="password-change-close">@Loc["Close"]</MudButton></div>
                }
            </div>
        }
    </SecurityStepBox>
}
else
{
<MudPaper Elevation="25" Class="pa-5">
    @if (Enforce)
    {
        <MudAlert Severity="Severity.Info">@Loc["You must change your password"]</MudAlert>
    }

    <EditForm Model="@dto" OnValidSubmit="Save">
        <LocalizedValidator />

        <PasswordField Label="@Loc["Current Password"]" @bind-Value="dto.CurrentPassword"
                      For="@(() => dto.CurrentPassword)" autocomplete="current-password" />

        <PasswordField Label="@Loc["New Password"]" HelperText="@Loc["Choose a strong password"]" @bind-Value="dto.NewPassword"
                      For="@(() => dto.NewPassword)" autocomplete="new-password" />
        <MudButton ButtonType="ButtonType.Button" OnClick="() => dto.NewPassword = PasswordGenerator.GeneratePassword(8)">@Loc["Generate password"]</MudButton>

        <PasswordField Label="@Loc["Confirm Password"]" @bind-Value="dto.ConfirmPassword"
                      For="@(() => dto.ConfirmPassword)" autocomplete="new-password" />

        <br />
        <br />

        <MudGrid Justify="Justify.FlexEnd">
            @if (MudDialog is not null)
            {
                <MudButton StartIcon="@Icons.Material.Filled.Cancel" OnClick="() => Cancel()">@Loc["Cancel"]</MudButton>
            }

            <MudButton Color="Color.Primary" ButtonType="ButtonType.Submit">
                <MudIcon Icon="@Icons.Material.Filled.Save" />
                <MudText Style="padding:0 10px;">@Loc["Save"]</MudText>
            </MudButton>
        </MudGrid>
    </EditForm>
</MudPaper>
}

@code {
    [CascadingParameter] public ShiftSoftware.ShiftIdentity.Blazor.Services.AdmissionUiContext? AdmissionContext { get; set; }
    private bool routedAdmission;
    // The identity host's own dashboard on the staged authority: an ordinary session changes its password through the
    // staged flow. A forced-change step token from the deployed login keeps the deployed route, which its adapter serves.
    private bool stagedSelfService, deciding, completed;
    // The form started the change itself, so it draws the box and owns cancel and close.
    private bool OwnsBox => deciding || stagedSelfService || routedAdmission;
    private string StepKey => deciding || AdmissionFlow is null ? "loading" : completed ? "done"
        : AdmissionFlow.Pending is { } pending ? pending.Step.ToString() : "ended";
    protected override async Task OnInitializedAsync()
    {
        routedAdmission = AdmissionFlow is null && AdmissionContext is not null;
        if (routedAdmission)
        {
            deciding = true;
            try
            {
                AdmissionFlow = AdmissionContext!.Flow;
                var access = (await storageService.GetTokenAsync())?.Token;
                if (access is null) { NavManager.NavigateTo("Identity/login"); return; }
                await HandleAdmission(await AdmissionFlow.BeginPasswordChangeAsync(access));
            }
            finally { deciding = false; }
            return;
        }
        if (AdmissionFlow is not null || !DashboardOptions.StagedAuthority) return;
        deciding = true;
        try
        {
            var token = await storageService.GetTokenAsync();
            if (token is not { Flow: AuthPurpose.None, Token: { Length: > 0 } access }) return;
            stagedSelfService = true;
            AdmissionFlow = Services.GetRequiredService<AuthenticationFlow>();
            await HandleAdmission(await AdmissionFlow.BeginPasswordChangeAsync(access));
        }
        finally { deciding = false; }
    }
    [Parameter] public AuthenticationFlow? AdmissionFlow { get; set; }
    [Parameter] public EventCallback<AuthOutcome> AdmissionCompleted { get; set; }
    private CurrentPasswordEntry currentEntry = new();
    private NewPasswordEntry newEntry = new();
    private string? admissionError;
    private sealed class CurrentPasswordEntry { [Required] public string Password { get; set; } = ""; }
    private sealed class NewPasswordEntry
    {
        [Required] public string Password { get; set; } = "";
        [Required, Compare(nameof(Password), ErrorMessage = "Passwords must match.")] public string Confirm { get; set; } = "";
    }
    // AuthForm closes a shown error before each press and runs one attempt at a time.
    private async Task ProveCurrentPassword()
    {
        var result = await AdmissionFlow!.ProvePasswordAsync(currentEntry.Password);
        currentEntry = new();
        await HandleAdmission(result);
    }
    private async Task SaveAdmissionPassword()
    {
        var result = await AdmissionFlow!.ChangePasswordAsync(newEntry.Password);
        newEntry = new();
        await HandleAdmission(result);
    }
    // A setup nested in this change shows its own error while its step stays; this form shows one only when it ended.
    private async Task HandleEnrollment(AuthOutcome result)
    {
        await HandleAdmission(result);
        if (AdmissionFlow?.Pending is { Step: AuthenticationStep.NewMfa }) admissionError = null;
    }
    private async Task HandleAdmission(AuthOutcome result)
    {
        admissionError = result switch
        {
            AuthenticationRefused { Code: AuthenticationFailure.InvalidNewPassword, PasswordFailure: var reason } =>
                Loc[reason == PasswordPolicyFailure.SameAsCurrent ? "Choose a password different from your current password."
                    : reason == PasswordPolicyFailure.Blocked ? "This password is too common or based on your username. Choose another."
                    : NewPasswordPolicy.Guidance],
            AuthenticationRefused { Code: AuthenticationFailure.InvalidProof } => Loc["That password or code was not accepted. Try again."],
            AuthenticationRefused => Loc["The operation could not be completed. Sign in again to check your password; a lost response may follow a completed change."],
            _ => null
        };
        await AdmissionCompleted.InvokeAsync(result);
        var changed = result is PasswordChanged { Continuation: SessionIssued } or MfaChanged { Continuation: SessionIssued };
        if (routedAdmission && changed)
            NavManager.NavigateTo("Identity/UserDataForm");
        if (stagedSelfService && changed)
        {
            // The flow stored the fresh initiating session; the authentication state and TypeAuth read it from there.
            await AuthenticationStateProvider.GetAuthenticationStateAsync();
            // Say that it worked before the dialog goes away. The user closes it.
            completed = true;
        }
    }
    private async Task CloseOwned()
    {
        if (completed) { Finish(); return; }
        var result = await AdmissionFlow!.CancelAsync();
        if (result is AuthenticationRefused)
        {
            admissionError = Loc["Cancellation could not be confirmed. Sign in again to check whether the password change completed."];
            return;
        }
        if (MudDialog is not null) CloseDialog();
        else NavManager.NavigateTo("Identity/UserDataForm");
    }
    private void Finish()
    {
        if (MudDialog is not null) CloseDialog();
        else NavManager.NavigateTo(ReturnUrl ?? "/", true);
    }
    // The profile opens this form in a narrow dialog of its own and closes it directly. A dialog that ShiftModal opened
    // is closed through ShiftModal, which also removes it from the address.
    private void CloseDialog()
    {
        if (SecurityDialog) MudDialog!.Close(DialogResult.Ok(completed));
        else ShiftModal.Close(MudDialog!);
    }
    private ChangePasswordDTO dto = new ChangePasswordDTO();

    [CascadingParameter]
    protected IMudDialogInstance? MudDialog { get; set; }

    /// <summary>Set by the page that opened this form in its own security dialog, which the form then closes directly.</summary>
    [Parameter] public bool SecurityDialog { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public bool Enforce { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private Task Cancel()
    {
        if (MudDialog is not null)
            ShiftModal.Close(MudDialog);

        return Task.CompletedTask;
    }

    private async Task Save()
    {
        try
        {
            var result = await UserManager.ChangePasswordAsync(dto);

            if (!result.IsSuccess)
            {
                Message.Error(result?.Data?.Message?.Body!, result?.Data?.Message?.Title);
                return;
            }

            await storageService.StoreTokenAsync(result?.Data?.Entity!);

            //Notify AuthenticationStateProvider and TypeAuth that auth state has changed
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

            if (MudDialog is not null)
            {
                ShiftModal.Close(MudDialog);
                return;
            }

            NavManager.NavigateTo(ReturnUrl ?? "/", true);
        }
        catch (Exception)
        {
            Message.Error(Loc["Your session has expired. Please log in again."]);
        }
    }
}
