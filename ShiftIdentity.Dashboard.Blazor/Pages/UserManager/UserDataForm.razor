@attribute [Authorize]
@layout Shared.DefaultLayout
@attribute [Route($"{Constants.IdentityRoutePreifix}/{nameof(UserDataForm)}")]
@inject ShiftModal ShiftModal
@inject HttpClient Http
@inject MessageService MessageService
@inject ShiftIdentityDashboardBlazorOptions DashboardOptions
@inject IServiceProvider Services
@inject IdentitySession Session
@using Microsoft.Extensions.DependencyInjection
@using ShiftSoftware.ShiftBlazor.Enums
@using ShiftSoftware.ShiftIdentity.Blazor
@using ShiftSoftware.ShiftIdentity.Core.Authentication
@using ShiftSoftware.ShiftIdentity.Core.Enums
@using AuthenticationFlow = ShiftSoftware.ShiftIdentity.Blazor.Services.AuthenticationFlow
@inject ShiftIdentityLocalizer Loc

@if (AdmissionContext is not null)
{
    <AdmissionAccountPanel Context="AdmissionContext" />
}
else
{
<ShiftEntityForm @bind-Mode="_mode"
                 Endpoint="UserManager/UserData"
                 Title="@Loc["Profile"]"
                 HideDelete="true"
                 HideRevisions="true"
                 Key="@("")"
                 T=" ShiftIdentity.Core.DTOs.User.UserDataDTO">
    <ToolbarStartTemplate>
        @if (_mode == FormModes.View)
        {
            <MudButton OnClick="ChangePassword" Size="Size.Small" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" data-testid="profile-change-password">@Loc["Change Password"]</MudButton>
            @if (!DashboardOptions.StagedAuthority)
            {
                <MudButton OnClick="ManageAuthenticator" Size="Size.Small" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" data-testid="profile-authenticator">@Loc["Enroll Two Factor"]</MudButton>
            }
            else if (authenticator is { RecoveryRequired: true })
            {
                <MudText Typo="Typo.body2" Class="ml-2 align-self-center" data-testid="profile-authenticator-status">@Loc["Authenticator recovery is required. Contact your administrator."]</MudText>
            }
            else
            {
                @* The authoritative state names the action: a first authenticator asks for the password, a replacement for the existing authenticator. *@
                <MudButton OnClick="ManageAuthenticator" Size="Size.Small" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" data-testid="profile-authenticator">
                    @(authenticator is null ? Loc["Authenticator"] : authenticator.Enrolled ? Loc["Replace authenticator"] : Loc["Set up authenticator"])
                </MudButton>
            }
        }
    </ToolbarStartTemplate>

    <ChildContent>
        <h2>@Loc["Security"]</h2>
        <MudDivider />

        <MudTextField Immediate="true"
                      ReadOnly="@context.ReadOnly"
                      Disabled="@context.Disabled"
                      OnlyValidateIfDirty="true"
                      Label="@Loc["Username"]"
                      @bind-Value="context.Item.Username"
                      For="@(() => context.Item.Username)" />

        <br />
        <br />

        <h2>@Loc["Contacts"]</h2>
        <MudDivider />
        <MudTextField Immediate="true"
                      ReadOnly="@context.ReadOnly"
                      Disabled="@context.Disabled"
                      OnlyValidateIfDirty="true"
                      Label="@Loc["Phone"]"
                      @bind-Value="context.Item.Phone"
                      For="@(() => context.Item.Phone)" />

        <MudTextField Immediate="true"
                      ReadOnly="@context.ReadOnly"
                      Disabled="@context.Disabled"
                      OnlyValidateIfDirty="true"
                      Label="@Loc["Email"]"
                      @bind-Value="context.Item.Email"
                      For="@(() => context.Item.Email)" />

        @if (!context.Item.EmailVerified && context.Mode == FormModes.View && !string.IsNullOrWhiteSpace(context.Item.Email))
        {
            <br />
            <MudButton Size="Size.Small"
                       OnClick="SendEmailVerification"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Email"
                       Variant="Variant.Text">
                @Loc["Send Email Verification"]
            </MudButton>
        }


        <br />
        <br />

        <h2>@Loc["Profile"]</h2>
        <MudDivider />
        <MudTextField Immediate="true"
                      ReadOnly="@context.ReadOnly"
                      Disabled="@context.Disabled"
                      OnlyValidateIfDirty="true"
                      Label="@Loc["Full Name"]"
                      @bind-Value="context.Item.FullName"
                      For="@(() => context.Item.FullName)" />

        <MudDatePicker ReadOnly="@context.ReadOnly"
                       Disabled="@context.Disabled"
                       @bind-Date="context.Item.BirthDate"
                       Label="@Loc["Birth Date"]"
                       For="@(() => context.Item.BirthDate)" />

        <MudItem xs="6" sm="6" lg="2" xl="2">
            <FileUploader ShowThumbnail="true"
                          Label="@Loc["Signature"]"
                          For="() => context.Item.Signature"
                          MaxFileCount="1"
                          AcceptImages="true"
                          DisableToolbar="true"
                          @bind-Values="context.Item.Signature" />
        </MudItem>

    </ChildContent>
</ShiftEntityForm>
}

@code {
    [CascadingParameter] public ShiftSoftware.ShiftIdentity.Blazor.Services.AdmissionUiContext? AdmissionContext { get; set; }
    private FormModes _mode;
    // The signed-in account's authenticator state under the staged authority; null until read or when it cannot be read.
    private AuthenticatorStatus? authenticator;

    protected override async Task OnInitializedAsync()
    {
        if (DashboardOptions.StagedAuthority && AdmissionContext is null)
            await ReadAuthenticatorAsync();
    }

    private async Task ReadAuthenticatorAsync()
    {
        var access = await Session.GetTokenAsync() is { Flow: AuthPurpose.None, Token: { Length: > 0 } token } ? token : null;
        authenticator = access is null ? null
            : await Services.GetRequiredService<AuthenticationFlow>().ReadAuthenticatorAsync(access) as AuthenticatorStatus;
    }

    private async Task ChangePassword() => await ShiftModal.Open<ChangePasswordForm>(null, ModalOpenMode.Popup, null);

    private async Task ManageAuthenticator()
    {
        await ShiftModal.Open<TotpEnrollmentForm>(null, ModalOpenMode.Popup, null);
        // Show the committed state once the dialog has closed, whichever way it closed.
        if (DashboardOptions.StagedAuthority) await ReadAuthenticatorAsync();
    }

    private async Task SendEmailVerification()
    {
        var response = await Http.GetAsync("usermanager/SendEmailVerificationLink");

        if (response.IsSuccessStatusCode)
        {
            MessageService.Success(Loc["Email verification link sent successfully."]);
        }
        else
        {
            var result = await response.Content.ReadFromJsonAsync <ShiftEntityResponse<UserDataDTO>>();
            MessageService.Error(result!.Message!.Body!);
        }
    }
}
