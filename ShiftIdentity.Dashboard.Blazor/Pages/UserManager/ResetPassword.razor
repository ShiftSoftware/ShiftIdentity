@attribute [Route($"{Constants.IdentityRoutePreifix}/{nameof(ResetPassword)}/{"{id}"}")]
@attribute [Route($"{Constants.IdentityRoutePreifix}/{nameof(ResetPassword)}")]
@layout Shared.LoginLayout
@using AuthenticationFlow = ShiftSoftware.ShiftIdentity.Blazor.Services.AuthenticationFlow
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services

@inject ShiftIdentityDashboardBlazorOptions ShiftIdentityDashboardBlazorOptions
@inject HttpClient Http
@inject MessageService msgService
@inject NavigationManager NavManager
@inject ShiftIdentityLocalizer Loc

@if (LinkFlow is not null) { <SecurityLinkForm Flow="LinkFlow" /> }
else
{
    @* The deployed reset link, until the staged authority is the only one: the same box as the staged page. *@
    <LoginBox ViewKey="legacy-reset" CanGoBack="true" Back="BackToLogin">
        <h1 class="auth-title" tabindex="-1">@Loc["Choose a new password"]</h1>
        <EditForm Model="@dto" OnValidSubmit="ResetPasswordAsync" class="auth-inputs">
            <LocalizedValidator />
            <PasswordField Label="@Loc["New Password"]" @bind-Value="dto.NewPassword" For="@(() => dto.NewPassword)" autocomplete="new-password" />
            <PasswordField Label="@Loc["Confirm Password"]" @bind-Value="dto.ConfirmPassword" For="@(() => dto.ConfirmPassword)" autocomplete="new-password" />
            <div class="auth-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">@Loc["Reset Password"]</MudButton></div>
        </EditForm>
    </LoginBox>
}

@code {
    private AuthenticationFlow? LinkFlow => AdmissionContext?.Flow ?? (ShiftIdentityDashboardBlazorOptions.StagedAuthority ? Services.GetRequiredService<AuthenticationFlow>() : null);
    [CascadingParameter] public ShiftSoftware.ShiftIdentity.Blazor.Services.AdmissionUiContext? AdmissionContext { get; set; }
    ResetPasswordDTO dto { get; set; } = new ResetPasswordDTO();

    [SupplyParameterFromQuery]
    public string? expires { get; set; }

    [SupplyParameterFromQuery]
    public string? token { get; set; }

    [Parameter]
    public string? id { get; set; }

    private void BackToLogin() => NavManager.NavigateTo($"{Constants.IdentityRoutePreifix}/login");

    private async Task ResetPasswordAsync()
    {
        var url = $"UserManager/ResetPassword/{id}?expires={expires}&token={token}";
        using var response = await Http.PostAsJsonAsync(url, dto);

        if (response.IsSuccessStatusCode)
        {
            msgService.Success(Loc["Your password reseted successfully"]);
            NavManager.NavigateTo($"{Constants.IdentityRoutePreifix}/login");
            return;
        };

        var data = await response.Content.ReadFromJsonAsync<ShiftEntityResponse<UserDataDTO>>();
        msgService.Error(data?.Message?.Body!);
    }
}
