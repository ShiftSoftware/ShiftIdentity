@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@using ShiftSoftware.ShiftIdentity.Blazor.Services
@using ShiftSoftware.ShiftIdentity.Core.Authentication
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ShiftIdentityLocalizer Loc
@implements IDisposable

<HeadContent><meta name="referrer" content="no-referrer" /></HeadContent>

@* The page a user reaches from an email link, in the login box: the host's logo and the same slide
   between the steps of the link (checking it, the form, done or failed) as between the steps of a sign-in. *@
<LoginBox ViewKey="@ViewKey">
<CascadingValue Value="feedback" IsFixed="true">
<div data-testid="security-link-form">
    @if (loading)
    {
        <div class="auth-center" role="status">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="auth-done-icon" />
            <p class="auth-description">@Loc["Checking your link…"]</p>
        </div>
    }
    else if (opened is not null)
    {
        <h1 class="auth-title" tabindex="-1">@Loc[Verification ? "Verify your email" : "Choose a new password"]</h1>
        <div class="auth-account" data-testid="security-link-target">
            <MudIcon Icon="@Icons.Material.Outlined.AccountCircle" Size="Size.Small" /><span>@opened.MaskedTarget</span>
        </div>
        @if (Verification)
        {
            <p class="auth-description">@Loc["Opening this page does not verify your email. Confirm that this email address belongs to you."]</p>
            <AuthError @bind-Message="error" TestId="security-link-error" />
            <div class="auth-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(feedback.Attempting || CurrentFlow.Busy)" OnClick="() => feedback.AttemptAsync(Verify)">@Loc[CurrentFlow.Busy ? "Verifying…" : "Verify my email"]</MudButton>
            </div>
        }
        else
        {
            <p class="auth-description">@Loc[NewPasswordPolicy.Guidance]</p>
            <AuthForm Model="entry" Submit="Reset" class="auth-inputs" Context="attempting">
                <PasswordField @key="(entryGeneration, 1)" Label="@Loc["New Password"]" @bind-Value="entry.Password" For="@(() => entry.Password)" Immediate="true" autocomplete="new-password" />
                <PasswordField @key="(entryGeneration, 2)" Label="@Loc["Confirm Password"]" @bind-Value="entry.Confirm" For="@(() => entry.Confirm)" Immediate="true" autocomplete="new-password" />
                <AuthError @bind-Message="error" TestId="security-link-error" />
                <div class="auth-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="@(attempting || CurrentFlow.Busy)">@Loc[CurrentFlow.Busy ? "Resetting password…" : "Reset Password"]</MudButton>
                </div>
            </AuthForm>
            <p class="auth-note">@Loc["Your authenticator and recovery requirements still apply after resetting your password."]</p>
        }
    }
    else if (verified)
    {
        <div class="auth-center" role="status" data-testid="email-verified">
            <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" Size="Size.Large" Class="auth-done-icon" />
            <h1 class="auth-title" tabindex="-1">@Loc["Email verified"]</h1>
            <p class="auth-description">@Loc["Your email is verified. You can now sign in."]</p>
            <div class="auth-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@SecurityLinkNavigation.LoginAfterVerification">@Loc["Go to login"]</MudButton></div>
        </div>
    }
    else if (error is not null)
    {
        @* The link has ended: a new one is the only way on. *@
        <div class="auth-center">
            <MudIcon Icon="@Icons.Material.Outlined.LinkOff" Size="Size.Large" Class="auth-done-icon auth-ended-icon" />
            <h1 class="auth-title" tabindex="-1">@Loc["This link can't be used"]</h1>
            <p class="auth-description" role="alert" data-testid="security-link-error">@error</p>
            <div class="auth-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@(Verification ? "Identity/SendEmailVerificationLink" : "Identity/SendResetPasswordLink")">@Loc["Request a new link"]</MudButton>
            </div>
        </div>
    }
</div>
</CascadingValue>
</LoginBox>
@* A user arrives here from an email, not from the login, so the way there is named as a destination, not a way back. *@
@if (!verified)
{
    <button type="button" class="security-link-exit" data-testid="security-link-login" @onclick="Cancel">
        @Loc["Go to login"]
    </button>
}

@code {
    [Parameter] public AdmissionUiContext? Context { get; set; }
    [Parameter] public AuthenticationFlow? Flow { get; set; }
    private AuthenticationFlow CurrentFlow => Flow ?? Context!.Flow;
    // The login box slides when the step changes: a new link, its form, and how it ended.
    private string ViewKey => loading ? "loading" : opened is not null ? "open" : verified ? "verified" : error is not null ? "ended" : "none";
    [Parameter] public bool Verification { get; set; }
    // The page's attempts: a shown error closes before each press, as in every security step.
    private readonly AuthFeedback feedback = new();
    private SecurityLinkOpened? opened;
    // One model for the page's life, as in the login form: a new model makes the EditForm rebuild its content, and an
    // error panel rebuilt open appears at once instead of sliding open.
    private readonly Entry entry = new();
    // Cleared fields start over untouched; a field the user typed in would flag its cleared value as missing.
    private int entryGeneration;
    private bool loading = true, verified, disposed, processing;
    private string? error, pendingUri;
    private string mountedPath = "";
    private long pageGeneration;
    private Task<AuthOutcome>? activeCompletion;
    private sealed class Entry
    {
        [Required, MaxLength(512)] public string Password { get; set; } = "";
        [Required, Compare(nameof(Password), ErrorMessage = "Passwords must match.")]
        public string Confirm { get; set; } = "";
        public void Clear() { Password = ""; Confirm = ""; }
    }
    protected override void OnInitialized()
    {
        mountedPath = new Uri(Navigation.Uri).AbsolutePath;
        pendingUri = Navigation.Uri;
        Navigation.LocationChanged += LocationChanged;
    }
    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (disposed) return;
        ClearPage();
        if (new Uri(args.Location).AbsolutePath.Equals(mountedPath, StringComparison.OrdinalIgnoreCase))
        {
            pendingUri = args.Location;
            loading = true;
        }
        _ = InvokeAsync(StateHasChanged);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (processing || disposed || pendingUri is null) return;
        processing = true;
        try
        {
            while (!disposed && pendingUri is { } uri)
            {
                pendingUri = null;
                var current = pageGeneration;
                var valid = SecurityLinkNavigation.TryRead(uri, Verification, out var grant, out var purpose);
                try
                {
                    // A navigation can replace a link during submission. Wait for its response, discard it,
                    // and then open only the latest queued link without overlapping the shared coordinator.
                    if (activeCompletion is { } completing) await completing;
                    if (disposed || current != pageGeneration) continue;
                    var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ShiftSoftware.ShiftIdentity.Dashboard.Blazor/security-link.js");
                    bool cleared;
                    try { cleared = await module.InvokeAsync<bool>("clearFragment", uri); }
                    finally { await module.DisposeAsync(); }
                    if (disposed || current != pageGeneration) continue;
                    // Exchanging a grant only establishes inert page context. The explicit submit makes the change.
                    var result = valid && cleared ? await CurrentFlow.OpenSecurityLinkAsync(grant, purpose)
                        : new AuthenticationRefused(AuthenticationFailure.InvalidGrant);
                    if (disposed || current != pageGeneration) continue;
                    opened = result as SecurityLinkOpened;
                    if (opened is null) error = Loc["This link is invalid, expired or has been replaced. Request a new link."];
                }
                catch (JSException)
                {
                    if (!disposed && current == pageGeneration) error = Loc["The link could not be opened. Please reopen it and try again."];
                }
                finally
                {
                    grant = "";
                    if (!disposed && current == pageGeneration) loading = false;
                }
                if (!disposed) StateHasChanged();
            }
        }
        finally { processing = false; }
    }
    private async Task Reset()
    {
        if (opened is null || entry.Password != entry.Confirm) return;
        var current = pageGeneration;
        activeCompletion = CurrentFlow.CompletePasswordResetAsync(opened.PageHandle, entry.Password);
        var result = await activeCompletion;
        activeCompletion = null;
        if (disposed || current != pageGeneration) return;
        ClearEntry();
        if (result is ReturnToLogin)
        {
            opened = null;
            Navigation.NavigateTo(SecurityLinkNavigation.LoginAfterReset, replace: true);
        }
        else HandleFailure(result);
    }
    private async Task Verify()
    {
        if (opened is null) return;
        var current = pageGeneration;
        activeCompletion = CurrentFlow.CompleteEmailVerificationAsync(opened.PageHandle);
        var result = await activeCompletion;
        activeCompletion = null;
        if (disposed || current != pageGeneration) return;
        if (result is EmailVerificationCompleted completed)
        {
            verified = true; opened = null; error = null;
            // Only the successful authority response supplies this host-configured destination.
            if (Uri.TryCreate(completed.RedirectUrl, UriKind.Absolute, out var redirect)
                && redirect.Scheme is "https" or "http" && string.IsNullOrEmpty(redirect.UserInfo))
                Navigation.NavigateTo(redirect.AbsoluteUri, forceLoad: true, replace: true);
        }
        else HandleFailure(result);
    }
    private void HandleFailure(AuthOutcome result)
    {
        if (result is AuthenticationRefused { Code: AuthenticationFailure.InvalidNewPassword })
            error = Loc["Choose a password that meets the password requirements and try again."];
        else
        {
            opened = null;
            error = Loc[Verification
                ? "Verification could not be confirmed. The link may have expired or been replaced. Request a new link."
                : "The change could not be confirmed. The link may have expired or been replaced. Request a new link; if you just reset your password, try signing in with the new password first."];
        }
    }
    private void Cancel()
    {
        ClearPage();
        Navigation.NavigateTo(SecurityLinkNavigation.LoginAfterCancel, replace: true);
    }
    private void ClearEntry() { entry.Clear(); entryGeneration++; }
    private void ClearPage()
    {
        pageGeneration++; pendingUri = null; opened = null; ClearEntry(); verified = false; error = null;
        loading = false; CurrentFlow.Restart();
    }
    public void Dispose()
    {
        Navigation.LocationChanged -= LocationChanged;
        disposed = true; ClearPage();
    }
}
