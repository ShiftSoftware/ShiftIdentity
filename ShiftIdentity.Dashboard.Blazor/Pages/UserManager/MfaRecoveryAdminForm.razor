@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.DependencyInjection
@using ShiftSoftware.ShiftIdentity.Blazor
@using ShiftSoftware.ShiftIdentity.Core.Authentication
@using ShiftSoftware.ShiftIdentity.Core.Enums
@using ShiftSoftware.ShiftIdentity.Dashboard.Blazor.Shared
@using AuthenticationFlow = ShiftSoftware.ShiftIdentity.Blazor.Services.AuthenticationFlow
@inject ShiftIdentityLocalizer Loc
@inject IServiceProvider Services
@inject IJSRuntime JS

@* The administrator's part of lost-device recovery: after an independent identity check, issue a single-use code
   that the user enters with their password to set up a new authenticator. The user form opens it in a dialog; the
   development app shows it inline in its account panel. *@
<SecurityStepBox Boxed="@Dialog" ViewKey="@(issued is null ? "note" : "issued")" Caption="@Loc["Recover authenticator"]"
                 Close="CloseDialog" CloseDisabled="@Flow.Busy">
    <div data-testid="mfa-recovery-admin-form" class="@(Dialog ? null : "pa-5")">
        @if (issued is null)
        {
            <MudText Typo="Typo.h6" Class="auth-title" tabindex="-1" data-auth-heading>@Loc["Help a user recover their authenticator"]</MudText>
            @if (!string.IsNullOrWhiteSpace(UserName)) { <p class="auth-description" data-testid="recovery-target">@UserName</p> }
            <p class="auth-description">@Loc["First confirm the person's identity using your team's procedure. Record the support ticket or a short note below. Shift saves this note for audit but cannot verify whether it is true."]</p>
            <MudAlert Severity="Severity.Warning" Dense="true" Class="auth-warning">@Loc["Issuing a recovery code disables the old authenticator. Local sign-in waits until the user completes recovery. The generated recovery code is separate from this note; give it to the verified person privately."]</MudAlert>
            <AuthForm Model="entry" Submit="Issue" class="auth-inputs" Context="attempting">
                <MudTextField T="string" Label="@Loc["Support ticket or identity-check note"]" @bind-Value="entry.Reference" For="@(() => entry.Reference)" Immediate="true" />
                <div class="auth-actions">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Warning" Disabled="@(attempting || Flow.Busy)">@Loc["Issue recovery code"]</MudButton>
                </div>
            </AuthForm>
        }
        else
        {
            <div class="auth-center" role="status">
                <MudIcon Icon="@Icons.Material.Outlined.Key" Color="Color.Primary" Size="Size.Large" Class="auth-done-icon" />
                <MudText Typo="Typo.h6" Class="auth-title" tabindex="-1" data-auth-heading>@Loc["Recovery code issued"]</MudText>
                <p class="auth-description">@Loc["Give this code to the verified person through your established private channel. It can be used once and expires at:"] @issued.ExpiresAt.ToLocalTime().ToString("t")</p>
            </div>
            <div class="auth-code" style="font-family:monospace;word-break:break-all" data-testid="recovery-code">@issued.Code</div>
            <div class="auth-center">
                <MudButton Variant="Variant.Text" StartIcon="@(codeCopied ? Icons.Material.Filled.Check : Icons.Material.Outlined.ContentCopy)" OnClick="CopyCodeAsync">@Loc[codeCopied ? "Copied" : "Copy code"]</MudButton>
            </div>
            <ol class="auth-steps" data-testid="recovery-next-steps">
                <li>@Loc["The user signs in with their username and password."]</li>
                <li>@Loc["They enter their password again, with this code."]</li>
                <li>@Loc["They set up a new authenticator app."]</li>
            </ol>
            <div class="auth-actions">
                @if (Dialog) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseDialog" data-testid="recovery-done">@Loc["Done"]</MudButton> }
                else { <MudButton OnClick="() => issued = null">@Loc["Hide code"]</MudButton> }
            </div>
        }
        <AuthError @bind-Message="error" TestId="recovery-admin-error" />
    </div>
</SecurityStepBox>

@code {
    /// <summary>The flow to issue through. The user form leaves it empty and the registered flow is used.</summary>
    [Parameter] public AuthenticationFlow? AdmissionFlow { get; set; }
    /// <summary>The operator's access token. Empty means the signed-in session's current token, read when the code is issued.</summary>
    [Parameter] public string AccessToken { get; set; } = "";
    [Parameter] public long UserID { get; set; }
    /// <summary>The target's encoded key, as a dashboard form holds it. Used instead of <see cref="UserID"/> when set.</summary>
    [Parameter] public string? UserKey { get; set; }
    [Parameter] public string? UserName { get; set; }
    /// <summary>Shown as the body of a security dialog: the login-box look, sliding from the note to the code.</summary>
    [Parameter] public bool Dialog { get; set; }
    [Parameter] public EventCallback<AuthOutcome> AdmissionCompleted { get; set; }
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    private sealed class Entry { [Required, StringLength(200, MinimumLength = 3)] public string Reference { get; set; } = ""; }
    private Entry entry = new();
    private MfaRecoveryCodeIssued? issued;
    private bool issuedOnce, codeCopied;
    private string? error;
    private string shownTarget = "";
    private string shownAccess = "";
    private AuthenticationFlow? flow;
    private AuthenticationFlow Flow => flow ??= AdmissionFlow ?? Services.GetRequiredService<AuthenticationFlow>();
    private string Target => UserKey is { Length: > 0 } key ? "key:" + key : "id:" + UserID;

    protected override void OnParametersSet()
    {
        if (AdmissionFlow is not null) flow = AdmissionFlow;
        // A new target or operator never sees the previous target's note, code or error.
        if (shownTarget == Target && shownAccess == AccessToken) return;
        shownTarget = Target; shownAccess = AccessToken;
        issued = null; error = null; entry = new(); codeCopied = false;
    }

    // AuthForm closes a shown error before each press and runs one attempt at a time.
    private async Task Issue()
    {
        issued = null; codeCopied = false;
        var subject = Target; var actor = AccessToken;
        var access = actor.Length > 0 ? actor : await CurrentAccessAsync();
        if (access is null)
        {
            error = Loc["Sign in again before issuing a recovery code."];
            return;
        }
        var result = UserKey is { Length: > 0 } key
            ? await Flow.IssueMfaRecoveryAsync(access, key, entry.Reference)
            : await Flow.IssueMfaRecoveryAsync(access, UserID, entry.Reference);
        // A response that arrives after the target or operator changed belongs to nobody on this screen.
        if (subject != Target || actor != AccessToken) return;
        issued = result as MfaRecoveryCodeIssued;
        issuedOnce |= issued is not null;
        error = result is AuthenticationRefused refused ? RefusalMessage(refused) : null;
        await AdmissionCompleted.InvokeAsync(result);
    }

    private string RefusalMessage(AuthenticationRefused refused) => refused.Code switch
    {
        AuthenticationFailure.ClientDenied => Loc["You need the Manage MFA Recovery permission to issue a recovery code, and you cannot issue one for your own account."],
        AuthenticationFailure.AccountUnavailable => Loc["This account is inactive or deleted, so its authenticator cannot be recovered."],
        AuthenticationFailure.StaleOperation => Loc["This account changed meanwhile. Close this window, open the user again and retry."],
        AuthenticationFailure.Unavailable => Loc["The recovery service is unavailable. Wait a moment and try again."],
        AuthenticationFailure.ReauthenticationRequired => Loc["Confirm your password when you are asked, then issue the code again."],
        _ => Loc["Recovery issuance could not be confirmed. Check your permission and sign in again. A lost response may require issuing a new code."]
    };

    private async Task<string?> CurrentAccessAsync() =>
        Services.GetService<IdentitySession>() is { } session &&
        await session.GetTokenAsync() is { Flow: AuthPurpose.None, Token: { Length: > 0 } token } ? token : null;

    private async Task CopyCodeAsync()
    {
        if (issued is null) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", issued.Code); codeCopied = true; }
        catch (JSException) { }
    }

    // The result says whether a code was issued at all, so the user form can show the new state.
    private void CloseDialog() => MudDialog?.Close(DialogResult.Ok(issuedOnce));
}
