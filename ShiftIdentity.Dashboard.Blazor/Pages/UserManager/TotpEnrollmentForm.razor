@attribute [Authorize]
@layout Shared.DefaultLayout
@attribute [Route($"{Constants.IdentityRoutePreifix}/{nameof(TotpEnrollmentForm)}")]
@inject ShiftModal ShiftModal
@inject MessageService Message
@inject UserManagerService UserManager
@inject NavigationManager NavManager
@inject IdentitySession storageService
@inject ShiftIdentityLocalizer Loc
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ShiftIdentityDashboardBlazorOptions DashboardOptions
@inject IServiceProvider Services
@using Microsoft.Extensions.DependencyInjection
@using MudBlazor
@using ShiftSoftware.ShiftIdentity.Core
@using ShiftSoftware.ShiftIdentity.Core.Enums
@using ShiftSoftware.ShiftIdentity.Blazor
@using ShiftSoftware.ShiftIdentity.Core.Authentication
@using AuthenticationFlow = ShiftSoftware.ShiftIdentity.Blazor.Services.AuthenticationFlow
@using System.ComponentModel.DataAnnotations

@if (AdmissionFlow is not null)
{
    <MudPaper Class="pa-5" data-testid="mfa-enrollment-form">
        @if (stagedSelfService && AdmissionFlow.Pending?.Step != AuthenticationStep.NewMfa)
        {
            <MudText Typo="Typo.h6" data-testid="mfa-enrollment-title">@(replacing ? Loc["Replace your authenticator"] : Loc["Set up your authenticator"])</MudText>
        }
        @if (recoveryRequired)
        {
            <MudAlert Severity="Severity.Warning" data-testid="restricted-step">@Loc["Authenticator recovery is required. Contact your administrator."]</MudAlert>
        }
        else if (AdmissionFlow.Pending is { Step: AuthenticationStep.Password })
        {
            <MudText Typo="Typo.h6">@Loc["Confirm your current password"]</MudText>
            <EditForm Model="passwordEntry" OnValidSubmit="ProveAdmissionPassword">
                <DataAnnotationsValidator />
                <PasswordField Label="@Loc["Current Password"]" @bind-Value="passwordEntry.Password"
                    For="@(() => passwordEntry.Password)" Immediate="true" autocomplete="current-password" />
                <MudButton ButtonType="ButtonType.Submit" Disabled="AdmissionFlow.Busy">@Loc["Continue"]</MudButton>
            </EditForm>
        }
        else if (AdmissionFlow.Pending is { Step: AuthenticationStep.ExistingMfa })
        {
            <MudText>@Loc["Confirm your existing authenticator before setting up its replacement."]</MudText>
            <MfaForm AdmissionFlow="AdmissionFlow" AdmissionCompleted="HandleAdmission" />
        }
        else if (AdmissionFlow.Pending is { Step: AuthenticationStep.NewMfa, NewAuthenticator: { } setup })
        {
            <MudText Typo="Typo.h6">@Loc["Set up your new authenticator"]</MudText>
            <MudText>@Loc["Scan the QR code, or enter the key manually. Then confirm a code from the new authenticator."]</MudText>
            <div style="max-width:240px;margin:16px auto" aria-label="@Loc["Authenticator setup QR code"]">@((MarkupString)PrepareSvg(setup.Svg))</div>
            <MudText Style="font-family:monospace;word-break:break-all" data-testid="enrollment-secret">@setup.Secret</MudText>
            <EditForm Model="codeEntry" OnValidSubmit="ConfirmAdmissionFactor">
                <DataAnnotationsValidator />
                <MudTextField T="string" Label="@Loc["New authenticator code"]" @bind-Value="codeEntry.Code"
                    For="@(() => codeEntry.Code)" Immediate="true" autocomplete="one-time-code" InputMode="InputMode.numeric" />
                <MudButton ButtonType="ButtonType.Submit" Disabled="AdmissionFlow.Busy" Color="Color.Primary">@Loc["Confirm authenticator"]</MudButton>
            </EditForm>
        }
        else if (AdmissionFlow.Pending is { } pending)
        {
            <MudAlert Severity="Severity.Info" data-testid="restricted-step">
                @(AdmissionFlow.MfaWasChanged ? Loc["Authenticator updated. Additional account verification is required before signing in."]
                    : Loc["Additional account verification is required before the authenticator can be changed."])
                @pending.Step
            </MudAlert>
        }
        @if (admissionError is not null)
        {
            <MudAlert Severity="Severity.Error" data-testid="mfa-error">@admissionError</MudAlert>
        }
        @if (AdmissionFlow.Pending?.Handle is not null)
        {
            <MudButton OnClick="CancelAdmission">@Loc["Cancel setup"]</MudButton>
        }
        else if (stagedSelfService)
        {
            <MudButton OnClick="() => CloseStaged(false)" data-testid="mfa-enrollment-close">@Loc["Close"]</MudButton>
        }
    </MudPaper>
}
else if (deciding)
{
    <MudPaper Class="pa-5" data-testid="mfa-enrollment-loading">
        <div class="d-flex justify-center pa-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    </MudPaper>
}
else
{
<MudPaper Elevation="25" Class="pa-5">
    @if (Enforce)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            @Loc["You must set up two-factor authentication to continue"]
        </MudAlert>
    }

    @if (state == State.Loading)
    {
        <div class="d-flex justify-center pa-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (state == State.LoadFailed)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @Loc["Could not start two-factor setup. Please try again."]
        </MudAlert>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="LoadAsync">
            @Loc["Retry"]
        </MudButton>
    }
    else
    {
        <MudText Typo="Typo.body1" Class="mb-4">
            @Loc["Scan the QR code with your authenticator app, then enter the 6-digit code it shows to finish setup."]
        </MudText>

        <div class="d-flex justify-center mb-4">
            <div style="width: 100%; max-width: 240px;" aria-label="@Loc["Two-factor authentication QR code"]">
                @((MarkupString)qrSvg!)
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(enrollment?.Secret))
        {
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-1">
                @Loc["Can't scan it? Enter this key manually:"]
            </MudText>
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-4"
                     Style="font-family: monospace; letter-spacing: .15em; word-break: break-all;">
                @enrollment?.Secret
            </MudText>
        }

        <EditForm Model="@dto" OnValidSubmit="VerifyAsync">
            <DataAnnotationsValidator />

            <MudTextField T="string" Label="@Loc["Code"]" @bind-Value="dto.Code"
                          For="@(() => dto.Code)" InputMode="InputMode.numeric"
                          Immediate="true" Disabled="submitting" autocomplete="one-time-code" />

            <MudGrid Justify="Justify.FlexEnd" Class="mt-4">
                @if (MudDialog is not null)
                {
                    <MudButton StartIcon="@Icons.Material.Filled.Cancel" OnClick="Cancel" Disabled="submitting">
                        @Loc["Cancel"]
                    </MudButton>
                }

                <MudButton Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="submitting">
                    @if (submitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Save" Class="mr-2" />
                    }
                    <MudText>@Loc["Verify"]</MudText>
                </MudButton>
            </MudGrid>
        </EditForm>
    }
</MudPaper>
}

@code {
    [CascadingParameter] public ShiftSoftware.ShiftIdentity.Blazor.Services.AdmissionUiContext? AdmissionContext { get; set; }
    private bool routedAdmission;
    // The identity host's own dashboard on the staged authority: an ordinary session sets up or replaces its
    // authenticator through the staged flow, which the authoritative state selects between. A mandatory-enrollment
    // step token from the deployed login keeps the deployed route, which its adapter serves.
    private bool stagedSelfService, deciding, replacing, recoveryRequired;
    [Parameter] public AuthenticationFlow? AdmissionFlow { get; set; }
    [Parameter] public EventCallback<AuthOutcome> AdmissionCompleted { get; set; }
    private sealed class PasswordEntry { [Required] public string Password { get; set; } = ""; }
    private sealed class CodeEntry { [Required, RegularExpression(@"^[0-9]{6,8}$")] public string Code { get; set; } = ""; }
    private PasswordEntry passwordEntry = new();
    private CodeEntry codeEntry = new();
    private string? admissionError;
    private async Task ProveAdmissionPassword()
    {
        var result = await AdmissionFlow!.ProvePasswordAsync(passwordEntry.Password);
        passwordEntry = new();
        await HandleAdmission(result);
    }
    private async Task ConfirmAdmissionFactor()
    {
        var result = await AdmissionFlow!.ConfirmNewFactorAsync(codeEntry.Code);
        codeEntry = new();
        await HandleAdmission(result);
    }
    private async Task CancelAdmission() => await HandleAdmission(await AdmissionFlow!.CancelAsync());
    private async Task HandleAdmission(AuthOutcome result)
    {
        admissionError = result is AuthenticationRefused { Code: AuthenticationFailure.InvalidProof }
            ? Loc["That password or code was not accepted. Try again."]
            : result is AuthenticationRefused ? Loc["Setup could not be confirmed. Sign in again to check which authenticator is active."] : null;
        await AdmissionCompleted.InvokeAsync(result);
        var finished = result is MfaChanged { Continuation: SessionIssued };
        if (routedAdmission && (finished || result is OperationCancelled))
            NavManager.NavigateTo("Identity/UserDataForm");
        if (!stagedSelfService) return;
        if (finished)
        {
            // The flow stored the fresh initiating session; the authentication state and TypeAuth read it from there.
            await AuthenticationStateProvider.GetAuthenticationStateAsync();
            CloseStaged(true);
        }
        else if (result is OperationCancelled) CloseStaged(false);
    }
    private void CloseStaged(bool finished)
    {
        if (MudDialog is not null) ShiftModal.Close(MudDialog);
        else if (finished) NavManager.NavigateTo(ReturnUrl ?? "/", forceLoad: true);
        else NavManager.NavigateTo("Identity/UserDataForm");
    }
    private enum State { Loading, Ready, LoadFailed }

    private readonly EnrollTotpDTO dto = new();

    private State state = State.Loading;
    private bool submitting;
    private TotpDTO? enrollment;
    private string? qrSvg;

    [CascadingParameter]
    protected IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public bool Enforce { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        routedAdmission = AdmissionFlow is null && AdmissionContext is not null;
        if (routedAdmission)
        {
            AdmissionFlow = AdmissionContext!.Flow;
            var account = await AdmissionContext.AccountAsync();
            var access = (await storageService.GetTokenAsync())?.Token;
            if (account is null || access is null) { NavManager.NavigateTo("Identity/login"); return; }
            await HandleAdmission(await AdmissionFlow.BeginMfaAsync(access, account.HasAuthenticator));
            return;
        }
        if (AdmissionFlow is not null) return;
        if (DashboardOptions.StagedAuthority && await BeginStagedAsync()) return;
        await LoadAsync();
    }

    private async Task<bool> BeginStagedAsync()
    {
        deciding = true;
        try
        {
            var token = await storageService.GetTokenAsync();
            if (token is not { Flow: AuthPurpose.None, Token: { Length: > 0 } access }) return false;
            stagedSelfService = true;
            AdmissionFlow = Services.GetRequiredService<AuthenticationFlow>();
            // The authoritative state decides which proof the flow asks for: the password for a first authenticator,
            // the existing authenticator for its replacement. An account in recovery cannot start either.
            var status = await AdmissionFlow.ReadAuthenticatorAsync(access);
            if (status is AuthenticatorStatus { RecoveryRequired: true }) { recoveryRequired = true; return true; }
            if (status is not AuthenticatorStatus current) { await HandleAdmission(status); return true; }
            replacing = current.Enrolled;
            await HandleAdmission(await AdmissionFlow.BeginMfaAsync(access, current.Enrolled));
            return true;
        }
        finally { deciding = false; }
    }

    private async Task LoadAsync()
    {
        state = State.Loading;

        try
        {
            var response = await UserManager.StartTotpEnrollmentAsync();
            var data = response.Data?.Entity;

            if (!response.IsSuccess || data is null)
            {
                state = State.LoadFailed;
                return;
            }

            enrollment = data;
            qrSvg = PrepareSvg(data.Svg);
            state = State.Ready;
        }
        catch (Exception)
        {
            state = State.LoadFailed;
        }
    }

    private async Task VerifyAsync()
    {
        submitting = true;
        try
        {
            var response = await UserManager.ConfirmTotpAsync(dto.Code, enrollment!);

            if (!response.IsSuccess)
            {
                var message = response.Data?.Message;
                Message.Error(response?.Data?.Message?.Body!, response?.Data?.Message?.Title);
                return;
            }

            await storageService.StoreTokenAsync(response?.Data?.Entity!);

            //Notify AuthenticationStateProvider and TypeAuth taht auth state has changed
            await AuthenticationStateProvider.GetAuthenticationStateAsync();


            if (MudDialog is not null)
            {
                ShiftModal.Close(MudDialog);
                return;
            }

            NavManager.NavigateTo(ReturnUrl ?? "/", forceLoad: true);
        }
        catch (Exception)
        {
            Message.Error(Loc["Your session has expired. Please log in again."]);
        }
        finally
        {
            submitting = false;
        }
    }

    private void Cancel()
    {
        if (MudDialog is not null)
            ShiftModal.Close(MudDialog);
    }

    // Makes the QR code scale to its container: drops the XML prolog so it renders cleanly
    // inline, then forces a responsive size (the SVG itself only carries a viewBox).
    private static string PrepareSvg(string svg)
    {
        var svgStart = svg.IndexOf("<svg", StringComparison.OrdinalIgnoreCase);
        if (svgStart > 0)
            svg = svg[svgStart..];

        return svg.Replace("<svg ", "<svg style=\"width:100%;height:auto;display:block;\" ", StringComparison.OrdinalIgnoreCase);
    }
}
