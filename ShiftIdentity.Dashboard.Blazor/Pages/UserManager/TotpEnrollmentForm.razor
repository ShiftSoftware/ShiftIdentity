@attribute [Authorize]
@layout Shared.DefaultLayout
@attribute [Route($"{Constants.IdentityRoutePreifix}/{nameof(TotpEnrollmentForm)}")]
@inject ShiftModal ShiftModal
@inject MessageService Message
@inject UserManagerService UserManager
@inject NavigationManager NavManager
@inject IdentitySession storageService
@inject ShiftIdentityLocalizer Loc
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ShiftIdentityDashboardBlazorOptions DashboardOptions
@inject IServiceProvider Services
@inject IJSRuntime JS
@using Microsoft.Extensions.DependencyInjection
@using MudBlazor
@using ShiftSoftware.ShiftIdentity.Core
@using ShiftSoftware.ShiftIdentity.Core.Enums
@using ShiftSoftware.ShiftIdentity.Blazor
@using ShiftSoftware.ShiftIdentity.Core.Authentication
@using AuthenticationFlow = ShiftSoftware.ShiftIdentity.Blazor.Services.AuthenticationFlow
@using System.ComponentModel.DataAnnotations

@if (AdmissionFlow is not null || deciding)
{
    @* Opened from the profile (or its own route), this form owns the setup and shows its steps in the login-box look,
       sliding from one to the next; the close button cancels the setup. As a step of a sign-in or of a password
       change it is already inside that flow's box. *@
    <SecurityStepBox Boxed="@OwnsBox" ViewKey="@StepKey" Caption="@Loc[replacing ? "Replace your authenticator" : "Set up your authenticator"]"
                     Close="CloseOwned" CloseDisabled="@(deciding || (AdmissionFlow?.Busy ?? true))">
        @if (deciding || AdmissionFlow is null)
        {
            <div class="d-flex justify-center pa-8" data-testid="mfa-enrollment-loading">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <div data-testid="mfa-enrollment-form">
                @if (completed)
                {
                    <div class="auth-center" role="status" data-testid="mfa-enrollment-done">
                        <MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" Color="Color.Success" Size="Size.Large" Class="auth-done-icon" />
                        <h1 class="auth-title" tabindex="-1">@Loc[replacing ? "Authenticator replaced" : "Authenticator set up"]</h1>
                        <p class="auth-description">@Loc[replacing ? "Your old authenticator no longer works. From now on, use the new app when you sign in."
                            : "From now on, sign in with your password and a code from this app."]</p>
                        <div class="auth-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => CloseStaged(true)" data-testid="mfa-enrollment-finish">@Loc["Done"]</MudButton></div>
                    </div>
                }
                else if (recoveryRequired)
                {
                    <div class="auth-center" data-testid="restricted-step">
                        <MudIcon Icon="@Icons.Material.Outlined.LockReset" Color="Color.Warning" Size="Size.Large" Class="auth-done-icon" />
                        <h1 class="auth-title" tabindex="-1">@Loc["Authenticator recovery is required"]</h1>
                        <p class="auth-description">@Loc["An administrator reset your authenticator app. Ask them for a recovery code. The next time you sign in, you enter it with your password and then set up a new authenticator app."]</p>
                        <div class="auth-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => CloseStaged(false)" data-testid="mfa-enrollment-close">@Loc["Close"]</MudButton></div>
                    </div>
                }
                else if (AdmissionFlow.Pending is { Step: AuthenticationStep.Password })
                {
                    <h1 class="auth-title" tabindex="-1">@Loc["Confirm your current password"]</h1>
                    <p class="auth-description">@Loc["Enter your password to start setting up an authenticator app."]</p>
                    <AuthForm Model="passwordEntry" Submit="ProveAdmissionPassword" class="auth-inputs" Context="attempting">
                        <PasswordField Label="@Loc["Current Password"]" @bind-Value="passwordEntry.Password"
                                       For="@(() => passwordEntry.Password)" Immediate="true" autocomplete="current-password" />
                        <div class="auth-actions">
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(attempting || AdmissionFlow.Busy)">@Loc["Continue"]</MudButton>
                        </div>
                    </AuthForm>
                }
                else if (AdmissionFlow.Pending is { Step: AuthenticationStep.ExistingMfa })
                {
                    <MfaForm AdmissionFlow="AdmissionFlow" AdmissionCompleted="HandleAdmission" Title="Confirm your current authenticator"
                             Description="Enter a code from the authenticator app you use now. It keeps working until the new one is confirmed." />
                }
                else if (AdmissionFlow.Pending is { Step: AuthenticationStep.NewMfa, NewAuthenticator: { } setup })
                {
                    <h1 class="auth-title" tabindex="-1">@Loc["Scan the QR code"]</h1>
                    <p class="auth-description">@Loc["Scan this code with your authenticator app, or enter the setup key by hand. Then enter the 6-digit code the app shows."]</p>
                    <div class="auth-qr" role="img" aria-label="@Loc["Authenticator setup QR code"]">@((MarkupString)PrepareSvg(setup.Svg))</div>
                    <span class="auth-key-label">@Loc["Setup key"]</span>
                    <div class="auth-key">
                        <span class="auth-key-value" data-testid="enrollment-secret">@GroupKey(setup.Secret)</span>
                        <MudIconButton Icon="@(keyCopied ? Icons.Material.Filled.Check : Icons.Material.Outlined.ContentCopy)" Size="Size.Small"
                                       aria-label="@Loc["Copy setup key"]" title="@Loc["Copy setup key"]" OnClick="() => CopyKeyAsync(setup.Secret)" />
                    </div>
                    <AuthForm Model="codeEntry" Submit="ConfirmAdmissionFactor" class="auth-inputs" Context="attempting">
                        <MudTextField T="string" Label="@Loc["Code from the new app"]" @bind-Value="codeEntry.Code"
                                      For="@(() => codeEntry.Code)" Immediate="true" autocomplete="one-time-code" InputMode="InputMode.numeric" spellcheck="false" />
                        <div class="auth-actions">
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(attempting || AdmissionFlow.Busy)">@Loc["Confirm authenticator"]</MudButton>
                        </div>
                    </AuthForm>
                }
                else if (AdmissionFlow.Pending is { } pending)
                {
                    <MudAlert Severity="Severity.Info" data-testid="restricted-step" data-step="@pending.Step">
                        @(AdmissionFlow.MfaWasChanged ? Loc["Authenticator updated. Additional account verification is required before signing in."]
                            : Loc["Additional account verification is required before the authenticator can be changed."])
                    </MudAlert>
                }
                <AuthError @bind-Message="admissionError" TestId="mfa-error" />
                @if (OwnsBox)
                {
                    @if (!completed && !recoveryRequired && AdmissionFlow.Pending is null)
                    {
                        @* Nothing is pending after a refusal: the setup has ended, and closing is the only way on. *@
                        <div class="auth-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => CloseStaged(false)" data-testid="mfa-enrollment-close">@Loc["Close"]</MudButton></div>
                    }
                }
                else if (AdmissionFlow.Pending?.Handle is not null)
                {
                    @* A step of another flow: the sign-in box has Back as well, but a visible way to stop the setup stays here. *@
                    <button type="button" class="auth-help" disabled="@(Feedback?.Attempting == true)" @onclick="CancelSetup">@Loc["Cancel setup"]</button>
                }
            </div>
        }
    </SecurityStepBox>
}
else
{
<MudPaper Elevation="25" Class="pa-5">
    @if (Enforce)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            @Loc["You must set up two-factor authentication to continue"]
        </MudAlert>
    }

    @if (state == State.Loading)
    {
        <div class="d-flex justify-center pa-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (state == State.LoadFailed)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @Loc["Could not start two-factor setup. Please try again."]
        </MudAlert>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="LoadAsync">
            @Loc["Retry"]
        </MudButton>
    }
    else
    {
        <MudText Typo="Typo.body1" Class="mb-4">
            @Loc["Scan the QR code with your authenticator app, then enter the 6-digit code it shows to finish setup."]
        </MudText>

        <div class="d-flex justify-center mb-4">
            <div style="width: 100%; max-width: 240px;" aria-label="@Loc["Two-factor authentication QR code"]">
                @((MarkupString)qrSvg!)
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(enrollment?.Secret))
        {
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-1">
                @Loc["Can't scan it? Enter this key manually:"]
            </MudText>
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-4"
                     Style="font-family: monospace; letter-spacing: .15em; word-break: break-all;">
                @enrollment?.Secret
            </MudText>
        }

        <EditForm Model="@dto" OnValidSubmit="VerifyAsync">
            <LocalizedValidator />

            <MudTextField T="string" Label="@Loc["Code"]" @bind-Value="dto.Code"
                          For="@(() => dto.Code)" InputMode="InputMode.numeric"
                          Immediate="true" Disabled="submitting" autocomplete="one-time-code" />

            <MudGrid Justify="Justify.FlexEnd" Class="mt-4">
                @if (MudDialog is not null)
                {
                    <MudButton StartIcon="@Icons.Material.Filled.Cancel" OnClick="Cancel" Disabled="submitting">
                        @Loc["Cancel"]
                    </MudButton>
                }

                <MudButton Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="submitting">
                    @if (submitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Save" Class="mr-2" />
                    }
                    <MudText>@Loc["Verify"]</MudText>
                </MudButton>
            </MudGrid>
        </EditForm>
    }
</MudPaper>
}

@code {
    [CascadingParameter] public ShiftSoftware.ShiftIdentity.Blazor.Services.AdmissionUiContext? AdmissionContext { get; set; }
    // The attempts of the flow this setup is a step of. A setup that owns its box has its own, inside the box.
    [CascadingParameter] private AuthFeedback? Feedback { get; set; }
    private bool routedAdmission;
    // The identity host's own dashboard on the staged authority: an ordinary session sets up or replaces its
    // authenticator through the staged flow, which the authoritative state selects between. A mandatory-enrollment
    // step token from the deployed login keeps the deployed route, which its adapter serves.
    private bool stagedSelfService, deciding, replacing, recoveryRequired, completed, keyCopied;
    // The form started the setup itself, so it draws the box and owns cancel and close.
    private bool OwnsBox => deciding || stagedSelfService || routedAdmission;
    private string StepKey => deciding || AdmissionFlow is null ? "loading" : completed ? "done" : recoveryRequired ? "recovery"
        : AdmissionFlow.Pending is { } pending ? pending.Step.ToString() : "ended";
    [Parameter] public AuthenticationFlow? AdmissionFlow { get; set; }
    [Parameter] public EventCallback<AuthOutcome> AdmissionCompleted { get; set; }
    private sealed class PasswordEntry { [Required] public string Password { get; set; } = ""; }
    private sealed class CodeEntry { [Required, RegularExpression(@"^[0-9]{6,8}$", ErrorMessage = "Enter the code the app shows, using digits only.")] public string Code { get; set; } = ""; }
    private PasswordEntry passwordEntry = new();
    private CodeEntry codeEntry = new();
    private string? admissionError;
    // AuthForm closes a shown error before each press and runs one attempt at a time.
    private async Task ProveAdmissionPassword()
    {
        var result = await AdmissionFlow!.ProvePasswordAsync(passwordEntry.Password);
        passwordEntry = new();
        await HandleAdmission(result);
    }
    private async Task ConfirmAdmissionFactor()
    {
        var result = await AdmissionFlow!.ConfirmNewFactorAsync(codeEntry.Code);
        codeEntry = new();
        await HandleAdmission(result);
    }
    // Cancelling is a press of the flow too, so a shown error closes first.
    private Task CancelSetup() => Feedback is null ? CancelAdmission() : Feedback.AttemptAsync(CancelAdmission);
    private async Task CancelAdmission() => await HandleAdmission(await AdmissionFlow!.CancelAsync());
    private async Task HandleAdmission(AuthOutcome result)
    {
        admissionError = result is AuthenticationRefused { Code: AuthenticationFailure.InvalidProof }
            ? Loc["That password or code was not accepted. Try again."]
            : result is AuthenticationRefused ? Loc["Setup could not be confirmed. Sign in again to check which authenticator is active."] : null;
        await AdmissionCompleted.InvokeAsync(result);
        var finished = result is MfaChanged { Continuation: SessionIssued };
        if (routedAdmission && (finished || result is OperationCancelled))
            NavManager.NavigateTo("Identity/UserDataForm");
        if (!stagedSelfService) return;
        if (finished)
        {
            // The flow stored the fresh initiating session; the authentication state and TypeAuth read it from there.
            await AuthenticationStateProvider.GetAuthenticationStateAsync();
            // Say that it worked before the dialog goes away. The user closes it.
            completed = true;
        }
        else if (result is OperationCancelled) CloseStaged(false);
    }
    // The header's close button: a pending setup is cancelled first, and the cancellation closes the form.
    private async Task CloseOwned()
    {
        if (completed) CloseStaged(true);
        else if (AdmissionFlow?.Pending?.Handle is not null) await CancelAdmission();
        else CloseStaged(false);
    }
    private void CloseStaged(bool finished)
    {
        if (MudDialog is not null)
        {
            // The profile opens this form in a narrow dialog of its own and closes it directly. A dialog that
            // ShiftModal opened is closed through ShiftModal, which also removes it from the address.
            if (SecurityDialog) MudDialog.Close(DialogResult.Ok(finished));
            else ShiftModal.Close(MudDialog);
        }
        else if (finished) NavManager.NavigateTo(ReturnUrl ?? "/", forceLoad: true);
        else NavManager.NavigateTo("Identity/UserDataForm");
    }
    // Groups the key in blocks of four, as authenticator apps show it. The apps ignore the spaces; the copy button
    // copies the key without them.
    private static string GroupKey(string key) => string.Join(' ', key.Chunk(4).Select(x => new string(x)));
    private async Task CopyKeyAsync(string key)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", key); keyCopied = true; }
        catch (JSException) { }
    }
    private enum State { Loading, Ready, LoadFailed }

    private readonly EnrollTotpDTO dto = new();

    private State state = State.Loading;
    private bool submitting;
    private TotpDTO? enrollment;
    private string? qrSvg;

    [CascadingParameter]
    protected IMudDialogInstance? MudDialog { get; set; }

    /// <summary>Set by the page that opened this form in its own security dialog, which the form then closes directly.</summary>
    [Parameter] public bool SecurityDialog { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public bool Enforce { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        routedAdmission = AdmissionFlow is null && AdmissionContext is not null;
        if (routedAdmission)
        {
            deciding = true;
            try
            {
                AdmissionFlow = AdmissionContext!.Flow;
                var account = await AdmissionContext.AccountAsync();
                var access = (await storageService.GetTokenAsync())?.Token;
                if (account is null || access is null) { NavManager.NavigateTo("Identity/login"); return; }
                replacing = account.HasAuthenticator;
                await HandleAdmission(await AdmissionFlow.BeginMfaAsync(access, account.HasAuthenticator));
            }
            finally { deciding = false; }
            return;
        }
        if (AdmissionFlow is not null) return;
        if (DashboardOptions.StagedAuthority && await BeginStagedAsync()) return;
        await LoadAsync();
    }

    private async Task<bool> BeginStagedAsync()
    {
        deciding = true;
        try
        {
            var token = await storageService.GetTokenAsync();
            if (token is not { Flow: AuthPurpose.None, Token: { Length: > 0 } access }) return false;
            stagedSelfService = true;
            AdmissionFlow = Services.GetRequiredService<AuthenticationFlow>();
            // The authoritative state decides which proof the flow asks for: the password for a first authenticator,
            // the existing authenticator for its replacement. An account in recovery cannot start either.
            var status = await AdmissionFlow.ReadAuthenticatorAsync(access);
            if (status is AuthenticatorStatus { RecoveryRequired: true }) { recoveryRequired = true; return true; }
            if (status is not AuthenticatorStatus current) { await HandleAdmission(status); return true; }
            replacing = current.Enrolled;
            await HandleAdmission(await AdmissionFlow.BeginMfaAsync(access, current.Enrolled));
            return true;
        }
        finally { deciding = false; }
    }

    private async Task LoadAsync()
    {
        state = State.Loading;

        try
        {
            var response = await UserManager.StartTotpEnrollmentAsync();
            var data = response.Data?.Entity;

            if (!response.IsSuccess || data is null)
            {
                state = State.LoadFailed;
                return;
            }

            enrollment = data;
            qrSvg = PrepareSvg(data.Svg);
            state = State.Ready;
        }
        catch (Exception)
        {
            state = State.LoadFailed;
        }
    }

    private async Task VerifyAsync()
    {
        submitting = true;
        try
        {
            var response = await UserManager.ConfirmTotpAsync(dto.Code, enrollment!);

            if (!response.IsSuccess)
            {
                var message = response.Data?.Message;
                Message.Error(response?.Data?.Message?.Body!, response?.Data?.Message?.Title);
                return;
            }

            await storageService.StoreTokenAsync(response?.Data?.Entity!);

            //Notify AuthenticationStateProvider and TypeAuth taht auth state has changed
            await AuthenticationStateProvider.GetAuthenticationStateAsync();


            if (MudDialog is not null)
            {
                ShiftModal.Close(MudDialog);
                return;
            }

            NavManager.NavigateTo(ReturnUrl ?? "/", forceLoad: true);
        }
        catch (Exception)
        {
            Message.Error(Loc["Your session has expired. Please log in again."]);
        }
        finally
        {
            submitting = false;
        }
    }

    private void Cancel()
    {
        if (MudDialog is not null)
            ShiftModal.Close(MudDialog);
    }

    // Makes the QR code scale to its container: drops the XML prolog so it renders cleanly
    // inline, then forces a responsive size (the SVG itself only carries a viewBox).
    private static string PrepareSvg(string svg)
    {
        var svgStart = svg.IndexOf("<svg", StringComparison.OrdinalIgnoreCase);
        if (svgStart > 0)
            svg = svg[svgStart..];

        return svg.Replace("<svg ", "<svg style=\"width:100%;height:auto;display:block;\" ", StringComparison.OrdinalIgnoreCase);
    }
}
