@attribute [Route($"{Constants.IdentityRoutePreifix}/login")]
@layout Shared.EmptyLayout
@implements IDisposable

@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization;
@using ShiftSoftware.ShiftIdentity.Blazor
@using ShiftSoftware.ShiftIdentity.Core.DTOs
@using ShiftSoftware.ShiftIdentity.Dashboard.Blazor.Pages.UserManager;
@using AuthenticationFlow = ShiftSoftware.ShiftIdentity.Blazor.Services.AuthenticationFlow
@using ShiftSoftware.ShiftIdentity.Core.Authentication

@inject ShiftIdentityDashboardBlazorOptions ShiftIdentityDashboardBlazorOptions
@inject Services.AuthService AuthService
@inject MessageService msgService
@inject IIdentityStore storageService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavManager
@inject ShiftIdentityLocalizer Loc

@*@inject Services.AuthService authService
@inject MessageService msgService
@inject Services.StorageService storageService
@inject TypeAuth.Blazor.Services.TypeAuthService TypeAuth*@

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="10" md="8" lg="6" xl="6">
        <MudPaper Class="pa-4">

            <br />
            <MudGrid Justify="Justify.Center">
                <MudItem xs="11" sm="11" md="10" lg="8" xl=6>
                    <MudImage Src="@ShiftIdentityDashboardBlazorOptions.LogoPath" Style="width:100%;" />
                </MudItem>
            </MudGrid>
            <br />
            <br />

            @if (recoveryMode && AdmissionFlow is not null)
            {
                <MfaRecoveryForm AdmissionFlow="AdmissionFlow" Username="@loginDto.Username" AdmissionCompleted="HandleAdmission" />
                <MudButton OnClick="RestartAdmission">@Loc["Back to login"]</MudButton>
            }
            else if (AdmissionFlow?.Pending is { } challenge)
            {
                @if (challenge.Step == AuthenticationStep.NewMfa)
                {
                    <TotpEnrollmentForm AdmissionFlow="AdmissionFlow" AdmissionCompleted="HandleAdmission" />
                }
                else if (challenge.Purpose == AuthenticationOperationPurpose.PasswordChange)
                {
                    <ChangePasswordForm AdmissionFlow="AdmissionFlow" AdmissionCompleted="HandleAdmission" />
                }
                else if (challenge.Step == AuthenticationStep.ExistingMfa)
                {
                    <MfaForm AdmissionFlow="AdmissionFlow" AdmissionCompleted="HandleAdmission" />
                }
                else
                {
                    <MudAlert Severity="Severity.Info" data-testid="restricted-step">@Loc["Additional account verification is required before signing in."]</MudAlert>
                }
                <MudButton OnClick="RestartAdmission">@Loc["Start again"]</MudButton>
                @if (challenge.Step is AuthenticationStep.PasswordChange or AuthenticationStep.MfaRecovery)
                {
                    <MudButton OnClick="() => recoveryMode = true">@Loc["Use an admin recovery code"]</MudButton>
                }
            }
            else
            {
            <EditForm Model="@loginDto" OnValidSubmit="Login">
                <DataAnnotationsValidator />
                <MudTextField T="string" Label="@Loc["Username"]" @bind-Value="loginDto.Username" For="@(() => loginDto.Username)" Immediate="@(AdmissionFlow is not null)" />

                <MudTextField T="string" Label="@Loc["Password"]" @bind-Value="loginDto.Password"
                              Immediate="@(AdmissionFlow is not null)"
                              For="@(() => loginDto.Password)"
                              InputType="@passwordInput"
                              Adornment="Adornment.End"
                              AdornmentIcon="@passwordIcon"
                              OnAdornmentClick="TogglePasswordVisibility"
                              AdornmentAriaLabel="@Loc["Show or hide password"]" />

                <br />
                @if (AdmissionFlow is null)
                {
                <MudButton Size="Size.Small"
                           Color="Color.Warning"
                           Href="@($"{Constants.IdentityRoutePreifix}/{nameof(SendResetPasswordLink)}")"
                           Variant="Variant.Text">
                    @Loc["Forgot Password?"]
                </MudButton>
                }

                <br />
                <br />

                <MudGrid Justify="Justify.Center">
                    <MudButton Disabled="@(AdmissionFlow?.Busy ?? false)" Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">@Loc["Login"]</MudButton>
                </MudGrid>
            </EditForm>
            @if (AdmissionFlow is not null)
            {
                <MudButton OnClick="() => recoveryMode = true">@Loc["Use an admin recovery code"]</MudButton>
            }
            }
            @if (AdmissionFlow?.ReturnToLoginRequired == true)
            {
                <MudAlert Severity="Severity.Success" data-testid="recovery-completed">@Loc["Authenticator recovery completed. Sign in with your password and a new code from your authenticator."]</MudAlert>
            }
            @if (admissionError is not null)
            {
                <MudAlert Severity="Severity.Error" data-testid="admission-error">@admissionError</MudAlert>
            }

            <br />
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    // Supplied by the isolated component harness; production registration supplies no adapter.
    [Parameter] public AuthenticationFlow? AdmissionFlow { get; set; }
    [Parameter] public EventCallback<SessionIssued> SessionCompleted { get; set; }
    private string? admissionError;
    private bool recoveryMode;
    public void Dispose() => AdmissionFlow?.Restart();

    private async Task RestartAdmission()
    {
        var result = AdmissionFlow is null ? null : await AdmissionFlow.CancelAsync();
        recoveryMode = false;
        loginDto.Password = string.Empty;
        admissionError = result is AuthenticationRefused
            ? Loc["Cancellation could not be confirmed. Sign in again to check whether the security change completed."] : null;
    }

    private async Task HandleAdmission(AuthOutcome outcome)
    {
        admissionError = outcome is AuthenticationRefused && AdmissionFlow?.Pending?.Purpose != AuthenticationOperationPurpose.PasswordChange
            ? Loc["Sign-in could not be completed. Try again."] : null;
        if (outcome is ChallengeRequired { Challenge.Step: AuthenticationStep.MfaRecovery }) recoveryMode = true;
        if (outcome is ChallengeRequired { Challenge.Step: AuthenticationStep.NewMfa } or MfaChanged) recoveryMode = false;
        var completed = outcome switch { PasswordChanged changed => changed.Continuation, MfaChanged changed => changed.Continuation, _ => outcome };
        if (completed is SessionIssued session)
        {
            await AuthenticationStateProvider.GetAuthenticationStateAsync();
            await SessionCompleted.InvokeAsync(session);
        }
    }

    LoginDTO loginDto { get; set; } = new LoginDTO();

    // Password show/hide toggle (the end-adornment icon button flips both the input type and icon).
    bool showPassword;
    InputType passwordInput = InputType.Password;
    string passwordIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
        passwordInput = showPassword ? InputType.Text : InputType.Password;
        passwordIcon = showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (authenticationStateTask != null)
        {
            var authState = await authenticationStateTask;

            //Return to home if user already loged-in
            if (authState?.User?.Identity?.IsAuthenticated ?? false)
                NavManager.NavigateTo("/");
        }

    }

    private async Task Login()
    {
        if (AdmissionFlow is not null)
        {
            var outcome = await AdmissionFlow.LoginAsync(loginDto.Username, loginDto.Password);
            loginDto.Password = string.Empty;
            await HandleAdmission(outcome);
            return;
        }
        var loginResult = await this.AuthService.LoginAsync(loginDto);

        if (!loginResult.IsSuccess)
        {
            msgService.Error(loginResult?.Data?.Message?.Body!, loginResult?.Data?.Message?.Title);

            return;
        }

        await storageService.StoreTokenAsync(loginResult?.Data?.Entity!);

        //Notify AuthenticationStateProvider and TypeAuth taht auth state has changed
        await AuthenticationStateProvider.GetAuthenticationStateAsync();

        //TypeAuth.AuthStateHasChanged();

        if (loginResult?.Data?.Entity?.Flow == Core.Enums.AuthPurpose.ChangePassword)
        {
            var url = $"{Constants.IdentityRoutePreifix}/{nameof(ChangePasswordForm)}";

            var queryStrings = new Dictionary<string, object?>();
            queryStrings.Add("ReturnUrl", ReturnUrl ?? "/");
            queryStrings.Add("Enforce", true);

            var uri = NavManager.GetUriWithQueryParameters(url, queryStrings);

            NavManager.NavigateTo(uri);
            return;
        }
        else if (loginResult?.Data?.Entity?.Flow == Core.Enums.AuthPurpose.Mfa)
        {
            var url = $"{Constants.IdentityRoutePreifix}/{nameof(MfaForm)}";

            var queryStrings = new Dictionary<string, object?>();
            queryStrings.Add("ReturnUrl", ReturnUrl ?? "/");

            var uri = NavManager.GetUriWithQueryParameters(url, queryStrings);

            NavManager.NavigateTo(uri);
            return;
        }
        else if (loginResult?.Data?.Entity?.Flow == Core.Enums.AuthPurpose.MfaEnrollment)
        {
            var url = $"{Constants.IdentityRoutePreifix}/{nameof(TotpEnrollmentForm)}";

            var queryStrings = new Dictionary<string, object?>();
            queryStrings.Add("ReturnUrl", ReturnUrl ?? "/");
            queryStrings.Add("Enforce", true);

            var uri = NavManager.GetUriWithQueryParameters(url, queryStrings);

            NavManager.NavigateTo(uri);
            return;
        }

        if (!String.IsNullOrWhiteSpace(ReturnUrl))
        {
            NavManager.NavigateTo(ReturnUrl, false);
            return;
        }
        else
        {
            NavManager.NavigateTo("/", false);
            return;
        }
    }
}
