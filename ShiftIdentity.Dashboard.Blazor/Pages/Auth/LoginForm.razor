@attribute [Route($"{Constants.IdentityRoutePreifix}/login")]
@layout Shared.LoginLayout
@implements IDisposable
@using Microsoft.Extensions.DependencyInjection
@using ShiftSoftware.ShiftIdentity.Blazor
@using ShiftSoftware.ShiftIdentity.Core.Authentication
@using AuthenticationFlow = ShiftSoftware.ShiftIdentity.Blazor.Services.AuthenticationFlow
@inject ShiftIdentityDashboardBlazorOptions ShiftIdentityDashboardBlazorOptions
@inject Services.AuthService AuthService
@inject IServiceProvider Services
@inject IdentitySession storageService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject ShiftIdentityLocalizer Loc

<LoginBox @ref="loginBox" ViewKey="@ViewKey" Direction="@direction" CanGoBack="@(view != "login")" TrackHistory="@(NavManager.HistoryEntryState == "shift-identity-login")" Back="Back">
    @{ var admissionNavigation = navigationAttempt; }
    @if (view == "access")
    {
        <h1 class="auth-title" tabindex="-1">@Loc["Can't access your account?"]</h1>
        <p class="auth-description">@Loc["Choose how you'd like to get back in."]</p>
        <div class="auth-choices">
            <button class="auth-choice" type="button" data-testid="login-reset-choice" @onclick="OpenReset">
                <MudIcon Icon="@Icons.Material.Outlined.Email" />
                <span><strong>@Loc["Forgot password"]</strong><small>@Loc["Get a password reset link by email."]</small></span>
                <MudIcon Class="auth-chevron" Icon="@Icons.Material.Filled.ChevronRight" />
            </button>
            @if (AdmissionFlow is not null)
            {
                <button class="auth-choice" type="button" data-testid="login-recovery-choice" @onclick="OpenRecovery">
                    <MudIcon Icon="@Icons.Material.Outlined.Security" />
                    <span><strong>@Loc["Recover your authenticator app"]</strong><small>@Loc["Restore two-factor authentication (MFA) using your current password and an admin recovery code."]</small></span>
                    <MudIcon Class="auth-chevron" Icon="@Icons.Material.Filled.ChevronRight" />
                </button>
            }
        </div>
    }
    else if (view is "reset" or "verification")
    {
        @if (AdmissionFlow is not null)
        {
            <SecurityEmailRequestForm @key="view" Flow="AdmissionFlow" Verification="@(view == "verification")" Embedded="true" ReturnToLogin="ReturnToLogin" RequestCompleted="RequestCompleted" />
        }
        else if (view == "reset") { <LegacyResetRequestForm ReturnToLogin="ReturnToLogin" RequestCompleted="RequestCompleted" /> }
    }
    else if (view == "recovery" && AdmissionFlow is not null)
    {
        <MfaRecoveryForm AdmissionFlow="AdmissionFlow" Username="@loginDto.Username" AdmissionCompleted="outcome => HandleContinuation(outcome, admissionNavigation)" />
    }
    else if (AdmissionFlow?.Pending is { } challenge)
    {
        @if (challenge.Step == AuthenticationStep.NewMfa)
        { <TotpEnrollmentForm AdmissionFlow="AdmissionFlow" AdmissionCompleted="outcome => HandleContinuation(outcome, admissionNavigation)" /> }
        else if (challenge.Step == AuthenticationStep.EmailVerification)
        {
            <h1 class="auth-title" tabindex="-1">@Loc["Verify your email"]</h1>
            <MudAlert Severity="Severity.Info" data-testid="restricted-step">@Loc["Verify your saved email address before signing in."]</MudAlert>
            <div class="auth-actions"><MudButton OnClick="OpenVerification" Variant="Variant.Filled" Color="Color.Primary">@Loc["Send email verification link"]</MudButton></div>
        }
        else if (challenge.Purpose == AuthenticationOperationPurpose.PasswordChange)
        { <ChangePasswordForm AdmissionFlow="AdmissionFlow" AdmissionCompleted="outcome => HandleContinuation(outcome, admissionNavigation)" /> }
        else if (challenge.Step == AuthenticationStep.ExistingMfa)
        { <MfaForm AdmissionFlow="AdmissionFlow" AdmissionCompleted="outcome => HandleContinuation(outcome, admissionNavigation)" /> }
        else
        { <MudAlert Severity="Severity.Info" data-testid="restricted-step">@Loc["Additional account verification is required before signing in."]</MudAlert> }
        @if (challenge.Step is AuthenticationStep.PasswordChange or AuthenticationStep.MfaRecovery)
        { <button type="button" class="auth-help" @onclick="OpenRecovery">@Loc["Recover your authenticator app"]</button> }
    }
    else
    {
        <AuthForm Model="loginDto" Submit="Login" class="auth-inputs" aria-busy="@(loginInProgress ? "true" : "false")" Context="attempting">
            <MudTextField T="string" Label="@Loc["Username"]" @bind-Value="loginDto.Username" For="@(() => loginDto.Username)" Immediate="true" Disabled="loginInProgress" autocomplete="username" />
            <PasswordField Label="@Loc["Password"]" @bind-Value="loginDto.Password" Immediate="true" For="@(() => loginDto.Password)" Disabled="loginInProgress" autocomplete="current-password" />
            <div class="auth-feedback-slot" data-open="@(loginFailure is not null ? "true" : "false")" aria-hidden="@(loginFailure is null ? "true" : "false")" inert="@(loginFailure is null)">
                <div class="auth-feedback-clip"><div class="auth-feedback-content">
                    <div class="auth-failure" data-login-failure>
                        @* Rendered only while a failure is shown or its panel is closing, so a host whose styles did not load shows no error before a sign-in attempt. *@
                        @if (lastFailure is not null)
                        {
                            <div class="auth-failure-message" role="alert" tabindex="-1" data-login-error data-testid="login-failure-message">
                                <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" />
                                <div><strong>@Loc[FailureMessage]</strong><p>@Loc[FailureHint]</p></div>
                            </div>
                            <button type="button" class="auth-help" data-testid="login-failure-help" @onclick="OpenAccess">@Loc["Can't access your account?"] <MudIcon Icon="@Icons.Material.Filled.ChevronRight" /></button>
                            @if (providerFailure is not null ? lastFailure is not AuthenticationFailure.ProviderAccountNotFound and not AuthenticationFailure.ProviderEmailUnverified
                                : lastFailure is not AuthenticationFailure.InvalidProof and not AuthenticationFailure.AccountUnavailable)
                            { <span class="auth-reference" data-testid="login-failure-reference">@Loc["Error reference"]: @FailureReference</span> }
                        }
                    </div>
                </div></div>
            </div>
            <div class="auth-actions"><MudButton Disabled="@(loginInProgress || (AdmissionFlow?.Busy ?? false))" Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">@Loc[loginInProgress ? "Signing in…" : "Login"]</MudButton></div>
            @if (providers.Count > 0)
            {
                <div class="auth-divider" aria-hidden="true"><span>@Loc["or"]</span></div>
                @foreach (var provider in providers)
                {
                    <button type="button" class="auth-provider" data-testid="login-@AuthenticationFlow.RouteName(provider)" disabled="@(loginInProgress || (AdmissionFlow?.Busy ?? false))" @onclick="() => SignInWithProvider(provider)">
                        @if (provider == SignInProvider.Google)
                        {
                            <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" /><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" /><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" /><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" /></svg>
                            <span>@Loc["Sign in with Google"]</span>
                        }
                        else
                        {
                            <svg width="20" height="20" viewBox="0 0 21 21" aria-hidden="true"><rect x="1" y="1" width="9" height="9" fill="#f25022" /><rect x="11" y="1" width="9" height="9" fill="#7fba00" /><rect x="1" y="11" width="9" height="9" fill="#00a4ef" /><rect x="11" y="11" width="9" height="9" fill="#ffb900" /></svg>
                            <span>@Loc["Sign in with Microsoft"]</span>
                        }
                    </button>
                }
            }
            <div class="auth-feedback-slot" data-open="@(loginFailure is null ? "true" : "false")" aria-hidden="@(loginFailure is not null ? "true" : "false")" inert="@(loginFailure is not null)">
                <div class="auth-feedback-clip"><div class="auth-feedback-content">
                    <button type="button" class="auth-help" data-testid="login-help" @onclick="OpenAccess">@Loc["Can't access your account?"]</button>
                </div></div>
            </div>
        </AuthForm>
        @if (AdmissionFlow?.ReturnToLoginRequired == true)
        { <MudAlert Class="auth-notice" Severity="Severity.Success" data-testid="recovery-completed">@Loc["Authenticator recovery completed. Sign in with your password and a new code from your authenticator."]</MudAlert> }
        @if ((AdmissionContext is not null || ShiftIdentityDashboardBlazorOptions.StagedAuthority) && SecurityLink == "reset")
        { <MudAlert Class="auth-notice" Severity="Severity.Success">@Loc["Password reset. Sign in with your new password."]</MudAlert> }
    }
    <AuthError @bind-Message="admissionError" TestId="admission-error" />
</LoginBox>

@code {
    [CascadingParameter] public ShiftSoftware.ShiftIdentity.Blazor.Services.AdmissionUiContext? AdmissionContext { get; set; }
    [Parameter] public AuthenticationFlow? AdmissionFlow { get; set; }
    [Parameter] public EventCallback<SessionIssued> SessionCompleted { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? authenticationStateTask { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "securityLink")] public string? SecurityLink { get; set; }
    private readonly LoginDTO loginDto = new();
    private string view = "login", loginPath = "";
    private string? admissionError;
    private AuthenticationFailure? loginFailure;
    // The failure the panel shows. It stays set while the panel closes after a retry, so the panel does not empty
    // before it has closed, and is cleared once it has closed or the view changes.
    private AuthenticationFailure? lastFailure;
    private int direction = 1, loginAttempt, navigationAttempt;
    private bool loginInProgress, disposed, requestCompleted;
    private LoginBox? loginBox;
    private TaskCompletionSource? feedbackExit;
    private string ViewKey => view == "challenge" ? $"challenge:{AdmissionFlow?.Pending?.Step}" : requestCompleted ? $"{view}:sent" : view;
    private void RequestCompleted() => requestCompleted = true;
    private string FailureMessage => lastFailure switch
    {
        AuthenticationFailure.Unavailable => "We couldn't reach the sign-in service.",
        AuthenticationFailure.ProviderAccountNotFound when providerFailure == SignInProvider.Google => "No account uses this Google account's email.",
        AuthenticationFailure.ProviderEmailUnverified when providerFailure == SignInProvider.Google => "Google can't confirm this account's email.",
        AuthenticationFailure.ProviderAccountNotFound => "No account uses this Microsoft account's email.",
        AuthenticationFailure.ProviderEmailUnverified => "Microsoft didn't confirm this account's email.",
        AuthenticationFailure.AccountUnavailable when providerFailure is not null => "This account can't sign in.",
        _ when providerFailure == SignInProvider.Google => "Google sign-in didn't complete.",
        _ when providerFailure is not null => "Microsoft sign-in didn't complete.",
        AuthenticationFailure.InvalidProof or AuthenticationFailure.AccountUnavailable => "Username or password is incorrect.",
        _ => "We couldn't sign you in."
    };
    private string FailureHint => lastFailure switch
    {
        AuthenticationFailure.Unavailable => "Check your connection and try again in a moment.",
        AuthenticationFailure.ProviderAccountNotFound => "Sign in with your username and password, or ask your administrator to put this email on your account.",
        AuthenticationFailure.ProviderEmailUnverified => "Sign in with your username and password instead.",
        AuthenticationFailure.AccountUnavailable when providerFailure is not null => "Contact your administrator.",
        _ when providerFailure is not null => "Try again. If the problem continues, share this error reference with your administrator.",
        AuthenticationFailure.InvalidProof or AuthenticationFailure.AccountUnavailable => "Try again, or get help accessing your account.",
        _ => "Try again in a moment. If the problem continues, share this error reference with your administrator."
    };
    private string FailureReference => lastFailure == AuthenticationFailure.Unavailable ? "LOGIN-SERVICE"
        : providerFailure is { } provider ? AuthenticationFlow.RouteName(provider).ToUpperInvariant() + "-" + lastFailure.ToString()!.ToUpperInvariant()
        : "LOGIN-REFUSED";
    // Sign in with a provider. The verifier and return path wait in session storage while the browser is at the provider.
    private static string PendingKey(SignInProvider provider) => "shift-identity-" + AuthenticationFlow.RouteName(provider);
    private sealed record PendingProvider(string Verifier, string? ReturnUrl);
    // The providers the host turned on, in button order.
    private IReadOnlyList<SignInProvider> providers = [];
    // providerFailure: the failure panel shows that provider's sign-in failure, not a password sign-in's.
    private SignInProvider? providerFailure;
    private string? providerReturnUrl;
    private static int Depth(string value) => value switch { "access" or "challenge" => 1, "reset" or "recovery" or "verification" => 2, _ => 0 };
    private string ReadView(string uri)
    {
        var value = System.Web.HttpUtility.ParseQueryString(NavManager.ToAbsoluteUri(uri).Query)["view"];
        return value switch
        {
            "access" or "reset" => value,
            "recovery" or "verification" when AdmissionFlow is not null => value,
            "challenge" when AdmissionFlow?.Pending is not null => value,
            _ => "login"
        };
    }
    private void NavigateView(string next, bool replace = false, bool trackHistory = true) => NavManager.NavigateTo(
        NavManager.GetUriWithQueryParameter("view", next == "login" ? null : next),
        new NavigationOptions { ReplaceHistoryEntry = replace, HistoryEntryState = trackHistory ? "shift-identity-login" : null });
    private void OpenAccess() => NavigateView("access");
    private void OpenReset() => NavigateView("reset");
    private void OpenRecovery() => NavigateView("recovery");
    private void OpenVerification() => NavigateView("verification");
    private void ReturnToLogin() => NavigateView("login", true);
    private async Task Back()
    {
        if (NavManager.HistoryEntryState == "shift-identity-login") await JS.InvokeVoidAsync("history.back");
        else if (loginBox is not null && await loginBox.TryHistoryBackAsync()) return;
        else NavigateView(view is "reset" or "recovery" ? "access" : "login", replace: true, trackHistory: false);
    }
    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (disposed || NavManager.ToAbsoluteUri(args.Location).AbsolutePath != loginPath) return;
        _ = InvokeAsync(async () =>
        {
            var next = ReadView(args.Location);
            if (next == view) return;
            var navigation = ++navigationAttempt;
            ++loginAttempt;
            direction = Depth(next) < Depth(view) ? -1 : 1;
            view = next;
            requestCompleted = false;
            loginFailure = lastFailure = null;
            loginDto.Password = string.Empty;
            admissionError = null;
            if (AdmissionFlow is not null && (AdmissionFlow.Pending is not null || AdmissionFlow.Busy))
            {
                var result = await AdmissionFlow.CancelAsync();
                if (disposed || navigation != navigationAttempt) return;
                if (result is AuthenticationRefused) admissionError = Loc["Cancellation could not be confirmed. Sign in again to check whether the security change completed."];
            }
            StateHasChanged();
        });
    }
    protected override async Task OnInitializedAsync()
    {
        AdmissionFlow ??= AdmissionContext?.Flow ?? (ShiftIdentityDashboardBlazorOptions.StagedAuthority ? Services.GetRequiredService<AuthenticationFlow>() : null);
        loginPath = NavManager.ToAbsoluteUri(NavManager.Uri).AbsolutePath;
        view = ReadView(NavManager.Uri);
        NavManager.LocationChanged += LocationChanged;
        if (authenticationStateTask is not null)
        {
            var authState = await authenticationStateTask;
            if ((authState.User.Identity?.IsAuthenticated ?? false) &&
                !((AdmissionContext is not null || ShiftIdentityDashboardBlazorOptions.StagedAuthority) && SecurityLink is "reset" or "verification" or "cancelled")) NavManager.NavigateTo("/");
        }
        if (AdmissionFlow is not null)
        {
            providers = (await AdmissionFlow.ReadProvidersAsync()).Enabled;
            await ResumeProvider();
        }
    }

    private async Task SignInWithProvider(SignInProvider provider)
    {
        if (AdmissionFlow is null || loginInProgress || disposed || AdmissionFlow.Busy) return;
        var attempt = ++loginAttempt;
        loginInProgress = true; admissionError = null; loginFailure = null;
        try
        {
            var (outcome, verifier) = await AdmissionFlow.StartProviderAsync(provider);
            if (disposed || attempt != loginAttempt) return;
            if (outcome is ProviderRedirect redirect && verifier is not null)
            {
                await JS.InvokeVoidAsync("sessionStorage.setItem", PendingKey(provider),
                    System.Text.Json.JsonSerializer.Serialize(new PendingProvider(verifier, ReturnUrl)));
                NavManager.NavigateTo(redirect.Url, forceLoad: true);
                return;
            }
            await ShowProviderFailure(provider, (outcome as AuthenticationRefused)?.Code ?? AuthenticationFailure.InvalidGrant);
        }
        catch (JSException) { await ShowProviderFailure(provider, AuthenticationFailure.Unavailable); }
        finally { loginInProgress = false; }
    }

    private Task ShowProviderFailure(SignInProvider provider, AuthenticationFailure failure)
    {
        providerFailure = provider;
        return ShowLoginFailure(failure);
    }

    // A provider returned to this page: a completion handle, or the reason there is none, waits in the fragment.
    private async Task ResumeProvider()
    {
        var fragment = NavManager.ToAbsoluteUri(NavManager.Uri).Fragment.TrimStart('#');
        SignInProvider? returned = null;
        string? handle = null, error = null;
        foreach (var candidate in new[] { SignInProvider.Microsoft, SignInProvider.Google })
        {
            var name = AuthenticationFlow.RouteName(candidate);
            if (fragment.StartsWith(name + "=", StringComparison.Ordinal)) (returned, handle) = (candidate, Uri.UnescapeDataString(fragment[(name.Length + 1)..]));
            else if (fragment.StartsWith(name + "-error=", StringComparison.Ordinal)) (returned, error) = (candidate, fragment[(name.Length + 7)..]);
        }
        if (returned is not { } provider) return;
        PendingProvider? pending = null;
        try
        {
            var stored = await JS.InvokeAsync<string?>("sessionStorage.getItem", PendingKey(provider));
            await JS.InvokeVoidAsync("sessionStorage.removeItem", PendingKey(provider));
            pending = stored is null ? null : System.Text.Json.JsonSerializer.Deserialize<PendingProvider>(stored);
        }
        catch (Exception failure) when (failure is JSException or System.Text.Json.JsonException) { }
        // Take the handle off the address first, so history does not keep it.
        NavManager.NavigateTo(loginPath, new NavigationOptions { ReplaceHistoryEntry = true });
        providerReturnUrl = pending?.ReturnUrl;
        if (error is not null)
        {
            await ShowProviderFailure(provider, Enum.TryParse<AuthenticationFailure>(error, out var code) && Enum.IsDefined(code)
                ? code : AuthenticationFailure.InvalidGrant);
            return;
        }
        if (pending is null || AdmissionFlow is null)
        {
            await ShowProviderFailure(provider, AuthenticationFailure.Expired);
            return;
        }
        var attempt = ++loginAttempt;
        loginInProgress = true;
        try
        {
            var outcome = await AdmissionFlow.CompleteProviderAsync(provider, handle!, pending.Verifier);
            if (disposed || attempt != loginAttempt) return;
            if (outcome is AuthenticationRefused refused) await ShowProviderFailure(provider, refused.Code);
            else await HandleAdmission(outcome);
        }
        finally { loginInProgress = false; }
    }
    public void Dispose()
    {
        disposed = true;
        ++loginAttempt; ++navigationAttempt;
        feedbackExit?.TrySetResult();
        NavManager.LocationChanged -= LocationChanged;
        AdmissionFlow?.Restart();
    }
    private Task HandleContinuation(AuthOutcome outcome, int navigation) =>
        navigation == navigationAttempt ? HandleAdmission(outcome) : Task.CompletedTask;
    private async Task HandleAdmission(AuthOutcome outcome)
    {
        if (disposed) return;
        // A step that stays on screen shows its own error: the password change, the new authenticator's setup and the
        // recovery form. This panel shows the rest, and every failure that ends the step.
        admissionError = outcome is AuthenticationRefused && view != "recovery" &&
            AdmissionFlow?.Pending is not ({ Purpose: AuthenticationOperationPurpose.PasswordChange } or { Step: AuthenticationStep.NewMfa })
            ? Loc["Sign-in could not be completed. Try again."] : null;
        if (outcome is ChallengeRequired required)
        {
            direction = 1;
            view = required.Challenge.Step == AuthenticationStep.MfaRecovery ? "recovery" : "challenge";
            NavigateView(view);
        }
        var completed = outcome switch { PasswordChanged changed => changed.Continuation, MfaChanged changed => changed.Continuation, _ => outcome };
        if (completed is ReturnToLogin) { view = "login"; direction = -1; NavigateView("login", true); }
        if (completed is SessionIssued session)
        {
            view = "login"; loginFailure = null;
            await AuthenticationStateProvider.GetAuthenticationStateAsync();
            await SessionCompleted.InvokeAsync(session);
            if (AdmissionContext is not null || ShiftIdentityDashboardBlazorOptions.StagedAuthority)
                NavManager.NavigateTo(ShiftSoftware.ShiftIdentity.Blazor.Services.AdmissionNavigation.LocalReturnPath(ReturnUrl ?? providerReturnUrl), forceLoad: true);
        }
    }
    private async Task Login()
    {
        if (loginInProgress || disposed || (AdmissionFlow?.Busy ?? false)) return;
        var attempt = ++loginAttempt;
        var waitForExit = loginFailure is not null;
        loginInProgress = true; admissionError = null; loginFailure = null;
        loginDto.Username = loginDto.Username?.Trim()!;
        try
        {
            if (waitForExit)
            {
                feedbackExit = new(TaskCreationOptions.RunContinuationsAsynchronously);
                var completed = feedbackExit.Task;
                StateHasChanged();
                await completed;
                lastFailure = null;
            }
            providerFailure = null;
            if (!disposed && attempt == loginAttempt) await SubmitLogin(attempt);
        }
        finally { loginInProgress = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (feedbackExit is not { } completed) return;
        feedbackExit = null;
        try
        {
            if (!disposed && loginBox is not null) await loginBox.WaitForFeedbackExitAsync();
        }
        finally { completed.TrySetResult(); }
    }
    private Task ShowLoginFailure(AuthenticationFailure failure)
    {
        if (!disposed) { admissionError = null; loginDto.Password = string.Empty; loginFailure = lastFailure = failure; }
        return Task.CompletedTask;
    }

    private async Task SubmitLogin(int attempt)
    {
        if (AdmissionFlow is not null)
        {
            var outcome = await AdmissionFlow.LoginAsync(loginDto.Username, loginDto.Password);
            loginDto.Password = string.Empty;
            if (disposed || attempt != loginAttempt) return;
            if (outcome is AuthenticationRefused refused)
            {
                await ShowLoginFailure(refused.Code);
                return;
            }
            await HandleAdmission(outcome);
            return;
        }
        HttpResponse<ShiftEntityResponse<TokenDTO>> loginResult;
        try { loginResult = await this.AuthService.LoginAsync(loginDto); }
        catch (Exception error) when (error is HttpRequestException or System.Text.Json.JsonException or NotSupportedException or TaskCanceledException)
        {
            if (!disposed && attempt == loginAttempt) await ShowLoginFailure(AuthenticationFailure.Unavailable);
            return;
        }
        if (disposed || attempt != loginAttempt) return;

        if (!loginResult.IsSuccess)
        {
            await ShowLoginFailure(loginResult.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden
                ? AuthenticationFailure.InvalidProof : AuthenticationFailure.Unavailable);
            return;
        }

        loginDto.Password = string.Empty;

        await storageService.StoreTokenAsync(loginResult?.Data?.Entity!);

        //Notify AuthenticationStateProvider and TypeAuth taht auth state has changed
        await AuthenticationStateProvider.GetAuthenticationStateAsync();

        //TypeAuth.AuthStateHasChanged();

        if (loginResult?.Data?.Entity?.Flow == Core.Enums.AuthPurpose.ChangePassword)
        {
            var url = $"{Constants.IdentityRoutePreifix}/{nameof(ChangePasswordForm)}";

            var queryStrings = new Dictionary<string, object?>();
            queryStrings.Add("ReturnUrl", ReturnUrl ?? "/");
            queryStrings.Add("Enforce", true);

            var uri = NavManager.GetUriWithQueryParameters(url, queryStrings);

            NavManager.NavigateTo(uri);
            return;
        }
        else if (loginResult?.Data?.Entity?.Flow == Core.Enums.AuthPurpose.Mfa)
        {
            var url = $"{Constants.IdentityRoutePreifix}/{nameof(MfaForm)}";

            var queryStrings = new Dictionary<string, object?>();
            queryStrings.Add("ReturnUrl", ReturnUrl ?? "/");

            var uri = NavManager.GetUriWithQueryParameters(url, queryStrings);

            NavManager.NavigateTo(uri);
            return;
        }
        else if (loginResult?.Data?.Entity?.Flow == Core.Enums.AuthPurpose.MfaEnrollment)
        {
            var url = $"{Constants.IdentityRoutePreifix}/{nameof(TotpEnrollmentForm)}";

            var queryStrings = new Dictionary<string, object?>();
            queryStrings.Add("ReturnUrl", ReturnUrl ?? "/");
            queryStrings.Add("Enforce", true);

            var uri = NavManager.GetUriWithQueryParameters(url, queryStrings);

            NavManager.NavigateTo(uri);
            return;
        }

        if (!String.IsNullOrWhiteSpace(ReturnUrl))
        {
            NavManager.NavigateTo(ReturnUrl, false);
            return;
        }
        else
        {
            NavManager.NavigateTo("/", false);
            return;
        }
    }
}
