@attribute [Authorize]
@layout Shared.DefaultLayout
@attribute [Route($"{Constants.IdentityRoutePreifix}/{nameof(CityForm)}/{{Key?}}")]
@inject HttpClient Http
@inject ODataQuery odataQuery
@inject ShiftIdentityLocalizer Loc

@using ShiftSoftware.ShiftIdentity.Core.DTOs.City
@using ShiftSoftware.ShiftIdentity.Core.DTOs.Region

<ShiftEntityForm Endpoint="@($"{Constants.IdentityRoutePreifix}City")"
                 Title="@Loc["City"]"
                 AllowSaveAsNew
                 @bind-Key="@Key"
                 TypeAuthAction="ShiftIdentityActions.Cities"
                 T="CityDTO">

    <LocalizedTextField @bind-Value="context.Item.Name" For="() => context.Item.Name" Label="@Loc["Name"]" />

    <ShiftAutocomplete Label="@Loc["Region"]"
                       For="@(() => context.Item.Region)"
                       @bind-Value="context.Item.Region"
                       EntitySet="IdentityRegion"
                       TEntitySet="RegionListDTO" />

    <MudTextFieldExtended @bind-Value="context.Item.IntegrationId" For="() => context.Item.IntegrationId" Label="@Loc["Integration ID"]" />

    <MudNumericFieldExtended ReadOnly="@context.ReadOnly"
                             Disabled="@context.Disabled"
                             OnlyValidateIfDirty="true"
                             Label="@Loc["Display Order"]"
                             @bind-Value="context.Item.DisplayOrder"
                             For="@(() => context.Item.DisplayOrder)" />
</ShiftEntityForm>

@code {
    [Parameter]
    public object? Key { get; set; }
}
