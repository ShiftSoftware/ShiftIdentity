@attribute [Authorize]
@layout Shared.DefaultLayout
@attribute [Route($"{Constants.IdentityRoutePreifix}/{nameof(ServiceForm)}/{{Key?}}")]
@inject HttpClient Http
@inject ShiftIdentityLocalizer Loc


<ShiftEntityForm @bind-Value="_theItem"
                 Endpoint="@($"{Constants.IdentityRoutePreifix}Service")"
                 Title="@Loc["Service"]"
                 AllowSaveAsNew
                 @bind-Key="@Key"
                 TypeAuthAction="ShiftIdentityActions.Services"
                 T="ShiftSoftware.ShiftIdentity.Core.DTOs.Service.ServiceDTO">

    <LocalizedTextField @bind-Value="context.Item.Name" For="() => context.Item.Name" Label="@Loc["Name"]" />

    <MudTextFieldExtended @bind-Value="context.Item.IntegrationId" Label="@Loc["Integration ID"]" For="() => context.Item.IntegrationId" />
</ShiftEntityForm>

@code {
    [Parameter]
    public object? Key { get; set; }

    private ShiftSoftware.ShiftIdentity.Core.DTOs.Service.ServiceDTO _theItem = new();

    [Parameter]
    public string? ServiceName { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(ServiceName))
        {
            _theItem.Name = ServiceName;
        }
    }
}