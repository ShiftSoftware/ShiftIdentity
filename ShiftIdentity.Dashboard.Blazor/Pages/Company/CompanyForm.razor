@attribute [Authorize]
@layout Shared.DefaultLayout
@attribute [Route($"{Constants.IdentityRoutePreifix}/{nameof(CompanyForm)}/{{Key?}}")]
@inject HttpClient Http
@inject ShiftIdentityDashboardBlazorOptions Options
@inject ShiftIdentityLocalizer Loc

@using ShiftSoftware.ShiftEntity.Model.Enums
@using ShiftSoftware.ShiftIdentity.Core.DTOs.Company


<ShiftEntityForm @bind-Value="_theItem"
                 AllowSaveAsNew
                 Endpoint="@($"{Constants.IdentityRoutePreifix}Company")"
                 Title="@Loc["Company"]"
                 @bind-Key="@Key"
                 OnTaskFinished="OnTaskFinished"
                 TypeAuthAction="ShiftIdentityActions.Companies"
                 T="ShiftSoftware.ShiftIdentity.Core.DTOs.Company.CompanyDTO">


    <MudGrid>

        <MudItem xs="12" sm="12" lg="12" xl="12">
            <LocalizedTextField @bind-Value="context.Item.Name" Label="@Loc["Name"]" For="() => context.Item.Name" />
        </MudItem>

        <MudItem xs="12" sm="12" lg="12" xl="12">
            <LocalizedTextField @bind-Value="context.Item.LegalName" Label="@Loc["Legal Name"]" For="() => context.Item.LegalName" />
        </MudItem>

        <MudItem xs="12" sm="6" lg="4" xl="3">
            <MudTextField ReadOnly="@context.ReadOnly"
                          Disabled="@context.Disabled"
                          OnlyValidateIfDirty="true"
                          Label="@Loc["Short Code"]"
                          @bind-Value="context.Item.ShortCode"
                          For="@(() => context.Item.ShortCode)" />
        </MudItem>

        <MudItem xs="12" sm="6" lg="4" xl="3">
            <MudTextField ReadOnly="@context.ReadOnly"
                          Disabled="@context.Disabled"
                          OnlyValidateIfDirty="true"
                          Label="@Loc["Integration ID"]"
                          @bind-Value="context.Item.IntegrationId"
                          For="@(() => context.Item.IntegrationId)" />
        </MudItem>

        <MudItem xs="12" sm="6" lg="4" xl="3">
            <MudSelect ReadOnly="@context.ReadOnly"
                       Disabled="@context.Disabled"
                       OnlyValidateIfDirty="true"
                       T="CompanyTypes"
                       Label="@Loc["Company Type"]"
                       @bind-Value="context.Item.CompanyType"
                       ToStringFunc="@(x=> x.Describe())"
                       For="@(() => context.Item.CompanyType)">
                <MudSelectItem Value="@(CompanyTypes.NotSpecified)" />
                <MudSelectItem Value="@(CompanyTypes.DistributorOrFranchisee)" />
                <MudSelectItem Value="@(CompanyTypes.RetailerOrDealer)" />
                <MudSelectItem Value="@(CompanyTypes.SupplierOrServiceProvider)" />
                <MudSelectItem Value="@(CompanyTypes.ThirdPartyOrExternal)" />
                <MudSelectItem Value="@(CompanyTypes.ParentCompanyOrFranchisor)" />
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6" lg="4" xl="3">
            <MudTextField ReadOnly="@context.ReadOnly"
                          Disabled="@context.Disabled"
                          OnlyValidateIfDirty="true"
                          Label="@Loc["HQ Phone"]"
                          @bind-Value="context.Item.HQPhone"
                          For="@(() => context.Item.HQPhone)" />
        </MudItem>

        <MudItem xs="12" sm="12" lg="12" xl="12">
            <LocalizedTextField @bind-Value="context.Item.HQAddress"
                                Label="@Loc["HQ Address"]"
                                For="() => context.Item.HQAddress" />
        </MudItem>

        <MudItem xs="12" sm="6" lg="4" xl="3">
            <MudTextField ReadOnly="@context.ReadOnly"
                          Disabled="@context.Disabled"
                          OnlyValidateIfDirty="true"
                          Label="@Loc["HQ Email"]"
                          @bind-Value="context.Item.HQEmail"
                          For="@(() => context.Item.HQEmail)" />
        </MudItem>

        <MudItem xs="12" sm="6" lg="4" xl="3">
            <MudTextField ReadOnly="@context.ReadOnly"
                          Disabled="@context.Disabled"
                          OnlyValidateIfDirty="true"
                          Label="@Loc["Website"]"
                          @bind-Value="context.Item.Website"
                          For="@(() => context.Item.Website)" />
        </MudItem>

        <MudItem xs="12" sm="6" lg="4" xl="3">
            <ShiftAutocomplete Label="@Loc["Parent Company"]"
                               For="@(() => context.Item.ParentCompany)"
                               @bind-Value="context.Item.ParentCompany"
                               EntitySet="IdentityCompany"
                               Filter="(string.IsNullOrWhiteSpace(context.Item.ID)? null: x=> x.Add(f => { f.Field = nameof(CompanyListDTO.ID); f.Value = context.Item.ID; f.Operator=ShiftBlazor.Enums.ODataOperator.NotEqual;}))"
                               TEntitySet="CompanyListDTO" />
        </MudItem>

        <MudItem xs="12" sm="6" lg="4" xl="3">
            <MudDatePickerExtended ReadOnly="@context.ReadOnly"
                          Disabled="@context.Disabled"
                          Clearable="true"
                          Label="@Loc["TerminationDate"]"
                          @bind-Date="context.Item.TerminationDate"
                          For="@(() => context.Item.TerminationDate)" />
        </MudItem>

        <MudItem xs="12" sm="6" lg="4" xl="3">
            <MudNumericFieldExtended ReadOnly="@context.ReadOnly"
                                     Disabled="@context.Disabled"
                                     OnlyValidateIfDirty="true"
                                     Label="@Loc["Display Order"]"
                                     @bind-Value="context.Item.DisplayOrder"
                                     For="@(() => context.Item.DisplayOrder)" />
        </MudItem>

        <MudItem xs="12" sm="12" lg="12" xl="12">
            <FileUploader ShowThumbnail="true"
                          Label="@Loc["Logo"]"
                          For="() => context.Item.Logo"
                          AcceptImages="true"
                          MaxFileCount="1"
                          @bind-Values="context.Item.Logo" />
        </MudItem>

        @if (context.Item.CustomFields is not null && context.Item.CustomFields?.Count > 0)
        {
            @foreach (var field in context.Item.CustomFields)
            {
                <MudItem xs="12" sm="6" lg="3" xl="3">
                    <MudTextField ReadOnly="@context.ReadOnly"
                                  Disabled="@context.Disabled"
                                  Label="@field.Value.DisplayName"
                                  Placeholder="@((field.Value.IsPassword && field.Value.HasValue)?"******":null)"
                                  InputType="@(field.Value.IsPassword?InputType.Password:InputType.Text)"
                                  @bind-Value="context.Item.CustomFields[field.Key].Value" />
                </MudItem>
            }
        }
    </MudGrid>
</ShiftEntityForm>

@code {
    [Parameter]
    public object? Key { get; set; }

    private ShiftSoftware.ShiftIdentity.Core.DTOs.Company.CompanyDTO _theItem = new();

    protected override Task OnInitializedAsync()
    {
        this.SetCustomFiles();

        return base.OnInitializedAsync();
    }

    private void OnTaskFinished()
    {
        this.SetCustomFiles();
    }

    private void SetCustomFiles()
    {
        // Only keep fields that are registred in Options
        _theItem.CustomFields = _theItem.CustomFields?
            .Where(kv => Options.CompanyCustomFields.ContainsKey(kv.Key))
            .ToDictionary(kv => kv.Key, kv => kv.Value);

        foreach (var field in this.Options.CompanyCustomFields)
        {
            if (_theItem.CustomFields?.ContainsKey(field.Key) ?? false)
                _theItem.CustomFields[field.Key]?.Set(field.Value);
            else
                _theItem.CustomFields?.TryAdd(field.Key, new CustomFieldDTO(field.Value));
        }
    }
}