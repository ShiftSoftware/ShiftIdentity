@attribute [Authorize]
@layout Shared.DefaultLayout
@attribute [Route($"{Constants.IdentityRoutePreifix}/{nameof(DepartmentForm)}/{{Key?}}")]
@inject HttpClient Http
@inject ShiftIdentityLocalizer Loc


<ShiftEntityForm @bind-Value="_theItem"
                 Endpoint="@($"{Constants.IdentityRoutePreifix}Department")"
                 Title="@Loc["Department"]"
                 AllowSaveAsNew
                 @bind-Key="@Key"
                 TypeAuthAction="ShiftIdentityActions.Departments"
                 T="ShiftSoftware.ShiftIdentity.Core.DTOs.Department.DepartmentDTO">

    <LocalizedTextField @bind-Value="context.Item.Name" For="() => context.Item.Name" Label="@Loc["Name"]" />

    <MudTextFieldExtended @bind-Value="context.Item.IntegrationId" Label="@Loc["Integration ID"]" For="() => context.Item.IntegrationId" />
</ShiftEntityForm>

@code {
    [Parameter]
    public object? Key { get; set; }

    private ShiftSoftware.ShiftIdentity.Core.DTOs.Department.DepartmentDTO _theItem = new();

    [Parameter]
    public string? DepartmentName { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(DepartmentName))
        {
            _theItem.Name = DepartmentName;
        }
    }
}