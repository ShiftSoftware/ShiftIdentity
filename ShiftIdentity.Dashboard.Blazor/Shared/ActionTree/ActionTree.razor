@inject ShiftIdentityLocalizer Loc

<style>
    .mud-treeview-item-content {
        padding: 0;
    }

    .no-margin .mud-button-icon-start {
        margin: 0 !important;
    }

    .type-auth-tree-text {
        margin: 0;
    }

        .type-auth-tree-text .mud-input-slot {
            padding: 3.8px 10px !important;
            font-size: 14px !important;
            background: #fafafa !important;
        }

    /* One row per action: icon and name first, the access controls right-aligned. The row wraps, so on a phone
       the controls move to their own line under the name instead of overflowing the card. */
    .action-tree-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 4px 8px;
        width: 100%;
        padding: 12px 10px;
        border-top: 1px solid #e1e1e1;
        transition: 0.3s;
    }

        .action-tree-row.action-tree-row-inherited {
            opacity: 0.6;
            background-color: var(--mud-palette-action-default-hover);
        }

    .action-tree-label {
        margin: 0;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .action-tree-access {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 5px;
        margin-left: auto;
        min-width: 0;
        max-width: 100%;
    }

        .action-tree-access .type-auth-tree-text {
            min-width: 8rem;
        }
</style>

<MudPaper Elevation="2">
    <MudToolBar Dense="true" Class="light-toolbar shift-toolbar-header">
        <MudIcon Icon="@Icons.Material.Filled.LockOpen"></MudIcon>
        <MudText Class="px-4" Style="margin:0;">@Loc["Actions"]</MudText>
    </MudToolBar>


    @if (this.TreeItems.Count == 0)
    {
        <MudAlert Severity="Severity.Warning">@Loc["No Items found."]</MudAlert>
    }
    else
    {
        <MudTreeView Items="@TreeItems" ExpandOnClick="true" Hover="true">
            <ItemTemplate>

                @if (context.Value is { } item && (item.ActionTreeItems.Count > 0 || item.Action != null) && IsShown(item))
                {
                    var extra = item.Extra();
                    <MudTreeViewItem Items="@extra.Children" ExpandedChanged="@((x) => { extra.Expanded = x; })" Expanded="@extra.Expanded">
                        <Content>
                            <MudTreeViewItemToggleButton ExpandedChanged="@((x) => { extra.Expanded = x; })" Visible="@(item.ActionTreeItems.Count > 0)" Expanded="@extra.Expanded" />
                            <ActionTreeRow Item="item" TypeAuth_View="tAuth_View" TypeAuth_LoggedInUser="tAuth_LoggedInUser"
                                           LoggedInUserTreeItems="LoggedInUserTreeItems_ByPath" ReadOnly="ReadOnly" Disabled="Disabled"
                                           PickerMode="PickerMode" LoggedInUserVersion="loggedInUserVersion" OnWildCardChanged="StateHasChanged" OnPick="PickAsync" />
                        </Content>
                    </MudTreeViewItem>
                }
            </ItemTemplate>
        </MudTreeView>
    }
</MudPaper>