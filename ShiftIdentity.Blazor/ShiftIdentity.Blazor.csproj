<Project Sdk="Microsoft.NET.Sdk.Razor">
	<Import Project="..\..\ShiftTemplates\ShiftFrameworkGlobalSettings.props" Condition="Exists('..\..\ShiftTemplates\ShiftFrameworkGlobalSettings.props')" />

	<!--The Azure Pipeline clones ShiftTemplates into a directory called 's' by default-->
	<Import Project="..\..\s\ShiftFrameworkGlobalSettings.props" Condition="Exists('..\..\s\ShiftFrameworkGlobalSettings.props')" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>ShiftSoftware.ShiftIdentity.Blazor</AssemblyName>
		<RootNamespace>ShiftSoftware.ShiftIdentity.Blazor</RootNamespace>
		<PackageId>ShiftSoftware.ShiftIdentity.Blazor</PackageId>
		<Version>$(ShiftFrameworkVersion)</Version>
		<Authors>aza.asim,Shift Software,Nahro</Authors>
		<PackageProjectUrl>https://github.com/ShiftSoftware/ShiftIdentity</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ShiftSoftware/ShiftIdentity</RepositoryUrl>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
		<PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Images\icon.png" Pack="true" PackagePath="\" />
		<Folder Include="Images\" />
	</ItemGroup>

	<!-- The JavaScript token client from clients/javascript/src, shipped as static web assets. A host serves them at
	     _content/ShiftSoftware.ShiftIdentity.Blazor/clients/shiftidentity-tokenclient.js and
	     _content/ShiftSoftware.ShiftIdentity.Blazor/clients/shiftidentity-tokenclient-issuer-v2.js.
	     Only the two source files ship. The tests and the README stay in clients/javascript.
	     ContentRoot is the folder the files really are in. Without it the SDK takes this project's wwwroot folder, which
	     does not exist, and a host that references this project (not the package) answers 404 for both files. -->
	<ItemGroup>
		<Content Include="..\clients\javascript\src\*.js" Link="wwwroot\clients\%(Filename)%(Extension)" ContentRoot="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', 'clients', 'javascript', 'src'))" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ShiftIdentity.Core\ShiftIdentity.Core.csproj" />
		<InternalsVisibleTo Include="ShiftSoftware.ShiftIdentity.Dashboard.Blazor" />
	</ItemGroup>
</Project>
