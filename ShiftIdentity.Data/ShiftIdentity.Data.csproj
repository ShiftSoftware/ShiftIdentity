<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\ShiftTemplates\ShiftFrameworkGlobalSettings.props" Condition="Exists('..\..\ShiftTemplates\ShiftFrameworkGlobalSettings.props')" />

	<!--The Azure Pipeline clones ShiftTemplates into a directory called 's' by default-->
	<Import Project="..\..\s\ShiftFrameworkGlobalSettings.props" Condition="Exists('..\..\s\ShiftFrameworkGlobalSettings.props')" />
	
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>ShiftSoftware.ShiftIdentity.Data</RootNamespace>
		<AssemblyName>ShiftSoftware.ShiftIdentity.Data</AssemblyName>
		<PackageId>ShiftSoftware.ShiftIdentity.Data</PackageId>
		<Version>$(ShiftFrameworkVersion)</Version>
		<Authors>aza.asim,Shift Software,Nahro</Authors>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<IsPackable>True</IsPackable>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ShiftIdentity.Core\ShiftIdentity.Core.csproj" />
		<ProjectReference Include="..\..\ShiftEntity\ShiftEntity.EFCore\ShiftEntity.EFCore.csproj" Condition="Exists('..\..\ShiftEntity\ShiftEntity.EFCore\ShiftEntity.EFCore.csproj')" />

		<!-- Dev-mode analyzer reference: the mapper source generator must run on THIS assembly, because the
		     ShiftIdentity entities (which carry the [ShiftEntity*Endpoint*] attributes and the (entity, list, view)
		     triples the generator emits mappers for) live here in ShiftIdentity.Data. In package mode the generator
		     ships inside the ShiftSoftware.ShiftEntity package, so this is only needed when the sibling ShiftEntity
		     repo is cloned (development mode). -->
		<ProjectReference Include="..\..\ShiftEntity\ShiftEntity.SourceGenerator\ShiftEntity.SourceGenerator.csproj" Condition="Exists('..\..\ShiftEntity\ShiftEntity.SourceGenerator\ShiftEntity.SourceGenerator.csproj')" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />

		<!-- ShiftMapper carries the Cosmos replication maps (Replication/ShiftIdentityReplicationMapper.cs). Its
		     generator MUST run on this assembly, not only on the host's: a consumer's generator sees this package as
		     metadata — never a method body — so the mapper's CreateMap calls, and the package's own AddShiftMapper
		     registration (Replication/IdentityReplicationMapperServiceCollectionExtensions.cs), reach it only as the
		     declaration attributes this project's own build writes. The same run writes this assembly's GENERATED mapper —
		     the one class holding the real Map methods, which that registration registers and Mapper dispatches to.
		     Dev mode wires both halves as projects; in package mode the single ShiftSoftware.ShiftMapper package
		     (below) brings the library and ships the generator as an analyzer. -->
		<ProjectReference Include="..\..\ShiftMapper\ShiftMapper\ShiftMapper.csproj" Condition="Exists('..\..\ShiftMapper\ShiftMapper\ShiftMapper.csproj')" />
		<ProjectReference Include="..\..\ShiftMapper\ShiftMapper.Generator\ShiftMapper.Generator.csproj" Condition="Exists('..\..\ShiftMapper\ShiftMapper.Generator\ShiftMapper.Generator.csproj')" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- The cache inside the identity reference source is internal: it is plumbing, not surface. The test
		     project drives it through the source's own methods and stands in for Cosmos at the read seam. -->
		<InternalsVisibleTo Include="ShiftIdentity.Data.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Images\icon.png" Pack="true" PackagePath="\" />
		<Folder Include="Images\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ShiftSoftware.ShiftEntity.EFCore" Version="$(ShiftFrameworkVersion)" Condition="!Exists('..\..\ShiftEntity\ShiftEntity.EFCore\ShiftEntity.EFCore.csproj')" />
		<PackageReference Include="ShiftSoftware.ShiftMapper" Version="$(ShiftMapperVersion)" Condition="!Exists('..\..\ShiftMapper\ShiftMapper\ShiftMapper.csproj')" />
		<PackageReference Include="Microsoft.Azure.Cosmos" Version="3.62.0" />
	</ItemGroup>

</Project>
