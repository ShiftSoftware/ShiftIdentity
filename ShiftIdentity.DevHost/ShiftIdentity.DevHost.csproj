<Project Sdk="Microsoft.NET.Sdk.Web">
	<Import Project="..\..\ShiftTemplates\ShiftFrameworkGlobalSettings.props" Condition="Exists('..\..\ShiftTemplates\ShiftFrameworkGlobalSettings.props')" />

	<!-- A local identity host for developing and reviewing the authority's flows by hand: the authority enabled on the
	     public dashboard registration, the dashboard's Blazor login, an owned throwaway SQL database with synthetic
	     accounts, and the /dev tools. It binds to loopback (and to the LAN address only on request), uses generated
	     keys, and drops its database when it stops. Start it with eng/Start-DevHost.ps1, or from Visual Studio with
	     the DevHost launch profile (with or without debugging, and through an active dev tunnel for a phone).
	     It is built on the test fixtures (SqlIdentityFixture and the combined host's registration in
	     ConfiguredIdentityHttpHost), so it is never packed, published or deployed. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<IsPublishable>false</IsPublishable>
		<RootNamespace>ShiftIdentity.DevHost</RootNamespace>
		<!-- The test fixtures bring xUnit's build files along. This is a program, not a test project: keep its entry point. -->
		<XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
	</PropertyGroup>

	<Target Name="RefuseDevHostPublication" BeforeTargets="Publish;Pack">
		<Error Text="ShiftIdentity.DevHost is a local development tool. It cannot be published or packed." />
	</Target>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ShiftIdentity.Tests\ShiftIdentity.Tests.csproj" />
		<ProjectReference Include="..\ShiftIdentity.DevHost.Client\ShiftIdentity.DevHost.Client.csproj" />
	</ItemGroup>

</Project>
