<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tests that need a SQL Server or wait on the real clock. They take minutes, so the release pipeline runs
       this project only when the tag name contains "with-long-running-tests"; run it locally on purpose.
       ShiftIdentity.Tests keeps the database-free tests and the shared fixtures this project builds on. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RootNamespace>ShiftIdentity.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <ProjectReference Include="..\ShiftIdentity.Tests\ShiftIdentity.Tests.csproj" />
  </ItemGroup>
</Project>
